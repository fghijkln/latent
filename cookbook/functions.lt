fn apply(fn_value, value):
    return fn_value(value)

fn scale_by(factor):
    fn scale(value):
        return factor * value
    return scale

twice = scale_by(2)
say apply(twice, 21)

fn make_counter():
    value = 0
    fn next_value():
        nonlocal value
        value = value + 1
        return value
    return next_value

counter = make_counter()
say counter()
say counter()
