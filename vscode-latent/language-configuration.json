{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:fn|class|if|elif|else|while|for|try|catch)\\b.*):\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif|else|catch)\\b.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:fn|class|if|elif|else|while|for|try|catch)\\b.*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
