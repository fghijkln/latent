math = py "math"
Long = java "java.lang.Long"
Math = java "java.lang.Math"
re = py "re"
ignorecase = re.I
type = "shadowed"

say 9007199254740993
say -9223372036854775808
say 9223372036854775807
say 2 ** 10
say 2 ** -3
say 1.0 + 2
say 1 / 2
say len([1, 2])
say range(1, 4)
try:
    values = range(-9223372036854775808, 9223372036854775807)
catch error:
    say error
say [-7 % 3, 7 % -3]
items = [8, 9]
say items[1]
say int(3.9)
say [9007199254740993, 1.0]
say 9007199254740993 == 9007199254740992.0
say 9007199254740992 == 9007199254740992.0
say int("9007199254740993")
say math.factorial(20)
try:
    value = math.factorial(21)
catch error:
    say error
say Long.parseLong("9007199254740993")
say Math.max(9007199254740993, 9007199254740992)

try:
    value = 9007199254740993 ** -1
catch error:
    say error

try:
    value = 2 ** -9007199254740993
catch error:
    say error

say ignorecase.name
say ignorecase.value

try:
    value = 9223372036854775807 + 1
catch error:
    say error

try:
    value = -9223372036854775808 - 1
catch error:
    say error

try:
    value = 9223372036854775807 * 2
catch error:
    say error

try:
    value = 2 ** 63
catch error:
    say error

try:
    value = -(-9223372036854775808)
catch error:
    say error

try:
    value = 9007199254740993 + 0.5
catch error:
    say error

try:
    value = 1 / 0
catch error:
    say error
