# P15 first Python emitter slice. The parser and emitter remain Latent modules;
# this entry point only coordinates their results with the thin OS adapter.
import "parser.lt" as parser
import "gen_py.lt" as gen_py
host = py "latent_host"

fn source_stem(path):
    name = host.path_basename(path)
    stem = ""
    for ch in name:
        if ch == ".":
            break
        stem = stem + ch
    return stem

fn compile_one(source_path, output_dir):
    read_result = host.read_utf8(source_path)
    if not read_result["ok"]:
        host.stderr(source_path + ": input error: " + read_result["error"] + "\n")
        return 1
    parsed = parser.parse(read_result["value"])
    if not parsed["ok"]:
        message = source_path + ":" + str(parsed["line"]) + ":" + str(parsed["col"])
        host.stderr(message + ": parse error: " + parsed["error"] + "\n")
        return 1
    generated = gen_py.generate(parsed["tree"])
    if not generated["ok"]:
        host.stderr(source_path + ": codegen error: " + generated["error"] + "\n")
        return 1
    directory_result = host.make_dirs(output_dir)
    if not directory_result["ok"]:
        host.stderr(output_dir + ": output error: " + directory_result["error"] + "\n")
        return 1
    output_path = host.path_join(output_dir, source_stem(source_path) + ".py")
    write_result = host.write_utf8(output_path, generated["code"])
    if not write_result["ok"]:
        host.stderr(output_path + ": output error: " + write_result["error"] + "\n")
        return 1
    host.stdout("wrote " + output_path + "\n")
    return 0

fn main():
    args = host.argv()
    if len(args) == 0:
        host.stderr("usage: latent source.lt [-o OUTDIR]\n")
        return 2
    source_path = ""
    output_dir = "build/py"
    take_output = false
    for arg in args:
        if take_output:
            output_dir = arg
            take_output = false
        elif arg == "-o":
            take_output = true
        elif source_path == "":
            source_path = arg
        else:
            host.stderr("error: unexpected argument " + arg + "\n")
            return 2
    if take_output:
        host.stderr("error: -o requires a directory\n")
        return 2
    if source_path == "":
        host.stderr("error: source path is required\n")
        return 2
    return compile_one(source_path, output_dir)

host.exit_process(main())
