# P15 first Python emitter slice. The parser and emitter remain Latent modules;
# this entry point only coordinates their results with the thin OS adapter.
import "desugar.lt" as desugar
import "semant.lt" as semant
import "gen_py.lt" as gen_py
import "module_graph.lt" as module_graph
host = py "latent_host"

fn source_stem(path):
    name = host.path_basename(path)
    index = 0
    last_dot = -1
    for ch in name:
        if ch == ".":
            last_dot = index
        index = index + 1
    if last_dot < 0:
        return name
    stem = ""
    index = 0
    while index < last_dot:
        stem = stem + name[index]
        index = index + 1
    return stem

fn compile_one(source_path, output_dir, run_after):
    graph = module_graph.load(source_path)
    if not graph["ok"]:
        if graph["kind"] == "input":
            host.stderr(source_path + ": input error: " + graph["error"] + "\n")
            return 1
        diagnostic_path = graph["source_id"]
        if diagnostic_path == source_path or diagnostic_path == host.path_basename(source_path):
            diagnostic_path = source_path
        host.stderr(diagnostic_path + ":" + str(graph["line"]) + ":" + str(graph["col"]) + ": " + graph["kind"] + " error: " + graph["error"] + "\n")
        return 1
    program = graph["root"]["tree"]
    module_metadata = nil
    if graph["import_count"] > 0:
        linked = module_graph.prepare(graph)
        if not linked["ok"]:
            diagnostic_path = linked["source_id"]
            if diagnostic_path == graph["root_id"]:
                diagnostic_path = source_path
            host.stderr(diagnostic_path + ":" + str(linked["line"]) + ":" + str(linked["col"]) + ": " + linked["kind"] + " error: " + linked["error"] + "\n")
            return 1
        program = linked["value"]["program"]
        module_metadata = linked["value"]["modules"]
    lowered = desugar.run(program)
    if not lowered["ok"]:
        message = graph["root_id"] + ":" + str(lowered["line"]) + ":" + str(lowered["col"])
        if lowered["source_id"] == graph["root_id"]:
            message = source_path + ":" + str(lowered["line"]) + ":" + str(lowered["col"])
        host.stderr(message + ": desugar error: " + lowered["error"] + "\n")
        return 1
    checked = semant.check(lowered["value"])
    if not checked["ok"]:
        message = graph["root_id"] + ":" + str(checked["line"]) + ":" + str(checked["col"])
        if checked["source_id"] == graph["root_id"]:
            message = source_path + ":" + str(checked["line"]) + ":" + str(checked["col"])
        host.stderr(message + ": semant error: " + checked["error"] + "\n")
        return 1
    if module_metadata != nil:
        generated = gen_py.generate_modules(lowered["value"], module_metadata, graph["root_id"])
    else:
        generated = gen_py.generate(lowered["value"])
    if not generated["ok"]:
        host.stderr(source_path + ": codegen error: " + generated["error"] + "\n")
        return 1
    directory_result = host.make_dirs(output_dir)
    if not directory_result["ok"]:
        host.stderr(output_dir + ": output error: " + directory_result["error"] + "\n")
        return 1
    output_path = host.path_join(output_dir, source_stem(source_path) + ".py")
    write_result = host.write_utf8(output_path, generated["code"])
    if not write_result["ok"]:
        host.stderr(output_path + ": output error: " + write_result["error"] + "\n")
        return 1
    host.stdout("wrote " + output_path + "\n")
    if run_after:
        execution = host.run_python(output_path)
        if not execution["ok"]:
            host.stderr("error: failed to run generated program: " + execution["error"] + "\n")
            return execution["returncode"]
        host.stdout(execution["stdout"])
        host.stderr(execution["stderr"])
        return execution["returncode"]
    return 0

fn main():
    args = host.argv()
    if len(args) == 0:
        host.stderr("usage: latent source.lt [-t py] [-o OUTDIR] [--run]\n")
        return 2
    source_path = ""
    output_dir = "build/py"
    target = "py"
    run_after = false
    take_output = false
    take_target = false
    for arg in args:
        if take_output:
            output_dir = arg
            take_output = false
        elif take_target:
            target = arg
            take_target = false
        elif arg == "--help" or arg == "-h":
            host.stdout("usage: latent source.lt [-t py] [-o OUTDIR] [--run]\n")
            return 0
        elif arg == "-o" or arg == "--outdir":
            take_output = true
        elif arg == "-t" or arg == "--target":
            take_target = true
        elif arg == "--run":
            run_after = true
        elif arg == "--show-ast" or arg == "--show-desugar" or arg == "--editor-metadata":
            host.stderr("error: diagnostic options are not supported by the bootstrap compiler\n")
            return 2
        elif source_path == "":
            source_path = arg
        else:
            host.stderr("error: unexpected argument " + arg + "\n")
            return 2
    if take_output:
        host.stderr("error: -o requires a directory\n")
        return 2
    if take_target:
        host.stderr("error: -t requires a target\n")
        return 2
    if target != "py":
        host.stderr("error: target '" + target + "' is unsupported; only 'py' is available\n")
        return 2
    if source_path == "":
        host.stderr("error: source path is required\n")
        return 2
    return compile_one(source_path, output_dir, run_after)

host.exit_process(main())
