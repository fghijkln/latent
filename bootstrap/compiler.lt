# P15 first Python emitter slice. The parser and emitter remain Latent modules;
# this entry point only coordinates their results with the thin OS adapter.
import "desugar.lt" as desugar
import "semant.lt" as semant
import "gen_py.lt" as gen_py
import "lexer.lt" as lexer
import "module_graph.lt" as module_graph
host = py "latent_host"

fn source_stem(path):
    name = host.path_basename(path)
    index = 0
    last_dot = -1
    for ch in name:
        if ch == ".":
            last_dot = index
        index = index + 1
    if last_dot < 0:
        return name
    stem = ""
    index = 0
    while index < last_dot:
        stem = stem + name[index]
        index = index + 1
    return stem

fn has_key(values, wanted):
    for key in values:
        if key == wanted:
            return true
    return false

fn repeat_spaces(count):
    output = ""
    index = 0
    while index < count:
        output = output + " "
        index = index + 1
    return output

fn diagnostic_context(graph, diagnostic, default_path):
    source = nil
    path = ""
    source_id = ""
    if has_key(diagnostic, "source_id"):
        source_id = diagnostic["source_id"]
    if has_key(diagnostic, "source"):
        source = diagnostic["source"]
    if has_key(diagnostic, "physical_path"):
        path = diagnostic["physical_path"]
    if graph["ok"]:
        for unit in graph["modules"]:
            if unit["source_id"] == source_id:
                if source == nil:
                    source = unit["source"]
                if path == "":
                    path = unit["path"]
                if source_id == graph["root_id"]:
                    path = default_path
    if path == "":
        if graph["ok"] and source_id == graph["root_id"]:
            path = default_path
        else:
            path = source_id
    return {"source": source, "path": path}

fn render_diagnostic(graph, diagnostic, default_path, kind):
    context = diagnostic_context(graph, diagnostic, default_path)
    line = diagnostic["line"]
    col = diagnostic["col"]
    header = context["path"] + ":" + str(line) + ":" + str(col) + ": " + kind + " error: " + diagnostic["error"]
    source = context["source"]
    if source == nil or line < 1:
        return header
    lines = lexer.source_lines(source)
    if line > len(lines):
        return header
    text = lexer.trim_trailing_cr(lines[line - 1])
    gutter = "    " + str(line) + " | "
    caret_col = col
    if caret_col < 1:
        caret_col = 1
    if caret_col > len(text) + 1:
        caret_col = len(text) + 1
    caret = repeat_spaces(len(gutter) + caret_col - 1) + "^"
    return header + "\n" + gutter + text + "\n" + caret

fn compile_one(source_path, output_dir, run_after, source_root):
    graph = module_graph.load(source_path, source_root)
    if not graph["ok"]:
        if graph["kind"] == "input":
            host.stderr(source_path + ": input error: " + graph["error"] + "\n")
            return 1
        host.stderr(render_diagnostic(graph, graph, source_path, graph["kind"]) + "\n")
        return 1
    program = graph["root"]["tree"]
    module_metadata = nil
    if graph["import_count"] > 0:
        linked = module_graph.prepare(graph)
        if not linked["ok"]:
            host.stderr(render_diagnostic(graph, linked, source_path, linked["kind"]) + "\n")
            return 1
        program = linked["value"]["program"]
        module_metadata = linked["value"]["modules"]
    lowered = desugar.run(program)
    if not lowered["ok"]:
        host.stderr(render_diagnostic(graph, lowered, source_path, "desugar") + "\n")
        return 1
    checked = semant.check(lowered["value"])
    if not checked["ok"]:
        host.stderr(render_diagnostic(graph, checked, source_path, "semant") + "\n")
        return 1
    if module_metadata != nil:
        generated = gen_py.generate_modules(lowered["value"], module_metadata, graph["root_id"])
    else:
        generated = gen_py.generate(lowered["value"])
    if not generated["ok"]:
        host.stderr(source_path + ": codegen error: " + generated["error"] + "\n")
        return 1
    directory_result = host.make_dirs(output_dir)
    if not directory_result["ok"]:
        host.stderr(output_dir + ": output error: " + directory_result["error"] + "\n")
        return 1
    output_path = host.path_join(output_dir, source_stem(source_path) + ".py")
    if host.path_is_dir(output_path):
        host.stderr(output_path + ": output error: is-directory\n")
        return 1
    runtime_files = ["LtJavaDaemon.java", "JReflect.java", "LtRt.java"]
    copied_runtime = host.copy_explicit_files(host.runtime_source_dir(), output_dir, runtime_files)
    if not copied_runtime["ok"]:
        host.stderr(output_dir + ": runtime output error: " + copied_runtime["error"] + "\n")
        return 1
    write_result = host.write_utf8(output_path, generated["code"])
    if not write_result["ok"]:
        host.stderr(output_path + ": output error: " + write_result["error"] + "\n")
        return 1
    host.stdout("wrote " + output_path + "\n")
    if run_after:
        execution = host.run_python(output_path)
        if not execution["ok"]:
            host.stderr("error: failed to run generated program: " + execution["error"] + "\n")
            return execution["returncode"]
        host.stdout(execution["stdout"])
        host.stderr(execution["stderr"])
        return execution["returncode"]
    return 0

fn main():
    args = host.argv()
    if len(args) == 0:
        host.stderr("usage: latent source.lt [-t py | --target py] [-o OUTDIR | --outdir OUTDIR] [--source-root ROOT] [--run] [-h | --help]\n")
        return 2
    source_path = ""
    output_dir = "build/py"
    source_root = nil
    target = "py"
    run_after = false
    take_output = false
    take_target = false
    take_source_root = false
    for arg in args:
        if take_output:
            output_dir = arg
            take_output = false
        elif take_target:
            target = arg
            take_target = false
        elif take_source_root:
            source_root = arg
            take_source_root = false
        elif arg == "--help" or arg == "-h":
            host.stdout("usage: latent source.lt [-t py | --target py] [-o OUTDIR | --outdir OUTDIR] [--source-root ROOT] [--run] [-h | --help]\n")
            return 0
        elif arg == "-o" or arg == "--outdir":
            take_output = true
        elif arg == "-t" or arg == "--target":
            take_target = true
        elif arg == "--source-root":
            take_source_root = true
        elif arg == "--run":
            run_after = true
        elif arg == "--show-ast" or arg == "--show-desugar" or arg == "--editor-metadata":
            host.stderr("error: diagnostic options are not supported by the bootstrap compiler\n")
            return 2
        elif source_path == "":
            source_path = arg
        else:
            host.stderr("error: unexpected argument " + arg + "\n")
            return 2
    if take_output:
        host.stderr("error: -o requires a directory\n")
        return 2
    if take_target:
        host.stderr("error: -t requires a target\n")
        return 2
    if take_source_root:
        host.stderr("error: --source-root requires a directory\n")
        return 2
    if target != "py":
        host.stderr("error: target '" + target + "' is unsupported; only 'py' is available\n")
        return 2
    if source_path == "":
        host.stderr("error: source path is required\n")
        return 2
    return compile_one(source_path, output_dir, run_after, source_root)

host.exit_process(main())
