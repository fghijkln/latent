# P15 limited Python emitter slice. P8-P11 function parameters/calls are supported;
# Java interop runtime helpers are emitted from a separate Latent module.
# All traversal, ordering, target spelling, and literal escaping stay in Latent.
import "java_runtime.lt" as java_runtime

fn result(code):
    return {"ok": true, "code": code, "error": ""}

fn failure(message):
    return {"ok": false, "code": "", "error": message}

fn quote_string(value):
    output = "\""
    for ch in value:
        if ch == "\\":
            output = output + "\\\\"
        elif ch == "\"":
            output = output + "\\\""
        elif ch == "\n":
            output = output + "\\n"
        elif ch == "\t":
            output = output + "\\t"
        elif ch == "\r":
            output = output + "\\r"
        elif ch == "\0":
            output = output + "\\0"
        else:
            output = output + ch
    return output + "\""

fn emit_expressions(expressions):
    output = ""
    first = true
    for expression in expressions:
        emitted = emit_expression(expression)
        if not emitted["ok"]:
            return emitted
        if first:
            first = false
        else:
            output = output + ", "
        output = output + emitted["code"]
    return result(output)

fn emit_call_arguments(arguments):
    output = ""
    first = true
    for argument in arguments:
        kind = argument["type"]
        if kind == "NamedArg":
            value = emit_expression(argument["value"])
            if not value["ok"]:
                return value
            emitted = result("_lt_bootstrap_named(" + quote_string(argument["name"]) + ", " + value["code"] + ")")
        elif kind == "StarArg":
            value = emit_expression(argument["value"])
            if not value["ok"]:
                return value
            emitted = result("_lt_bootstrap_star(" + value["code"] + ")")
        elif kind == "StarStarArg":
            value = emit_expression(argument["value"])
            if not value["ok"]:
                return value
            emitted = result("_lt_bootstrap_starstar(" + value["code"] + ")")
        else:
            emitted = emit_expression(argument)
        if not emitted["ok"]:
            return emitted
        if first:
            first = false
        else:
            output = output + ", "
        output = output + emitted["code"]
    return result(output)

fn emit_map_pairs(pairs):
    output = ""
    first = true
    for pair in pairs:
        emitted = emit_expression(pair["value"])
        if not emitted["ok"]:
            return emitted
        if first:
            first = false
        else:
            output = output + ", "
        output = output + quote_string(pair["key"]) + ": " + emitted["code"]
    return result(output)

fn emit_expression(node):
    kind = node["type"]
    if kind == "Num":
        return result("float(" + str(node["value"]) + ")")
    if kind == "Str":
        return result(quote_string(node["value"]))
    if kind == "Bool":
        if node["value"]:
            return result("True")
        return result("False")
    if kind == "Nil":
        return result("None")
    if kind == "Name":
        if node["id"] == "__say":
            return result("_lt_bootstrap_say")
        if node["id"] == "int":
            return result("_lt_bootstrap_int")
        if node["id"] == "range":
            return result("_lt_bootstrap_range")
        if node["id"] == "len":
            return result("_lt_bootstrap_len")
        if node["id"] == "str":
            return result("_lt_bootstrap_str")
        if node["id"] == "__wgetattr":
            return result("_lt_bootstrap_wgetattr")
        if node["id"] == "__wcall":
            return result("_lt_bootstrap_wcall")
        if node["id"] == "__wsetattr":
            return result("_lt_bootstrap_wsetattr")
        if node["id"] == "__index":
            return result("_lt_bootstrap_index")
        if node["id"] == "__wsetindex":
            return result("_lt_bootstrap_wsetindex")
        if node["id"] == "keys":
            return result("_lt_bootstrap_keys")
        if node["id"] == "push":
            return result("_lt_bootstrap_push")
        return result(node["id"])
    if kind == "BinOp":
        left = emit_expression(node["left"])
        if not left["ok"]:
            return left
        right = emit_expression(node["right"])
        if not right["ok"]:
            return right
        if node["op"] == "==":
            return result("_lt_bootstrap_eq(" + left["code"] + ", " + right["code"] + ")")
        if node["op"] == "!=":
            return result("(not _lt_bootstrap_eq(" + left["code"] + ", " + right["code"] + "))")
        if node["op"] == "**":
            return result("_lt_bootstrap_pow(" + left["code"] + ", " + right["code"] + ")")
        return result("(" + left["code"] + " " + node["op"] + " " + right["code"] + ")")
    if kind == "UnOp":
        operand = emit_expression(node["operand"])
        if not operand["ok"]:
            return operand
        if node["op"] == "not":
            return result("(not " + operand["code"] + ")")
        return result("(" + node["op"] + operand["code"] + ")")
    if kind == "Call":
        function = emit_expression(node["func"])
        if not function["ok"]:
            return function
        arguments = emit_call_arguments(node["args"])
        if not arguments["ok"]:
            return arguments
        suffix = ""
        if arguments["code"] != "":
            suffix = ", " + arguments["code"]
        if function["code"] == "_lt_bootstrap_wcall":
            return result(function["code"] + "(" + arguments["code"] + ")")
        return result("_lt_bootstrap_call(" + function["code"] + suffix + ")")
    if kind == "Dot":
        object = emit_expression(node["obj"])
        if not object["ok"]:
            return object
        return result(object["code"] + "." + node["attr"])
    if kind == "Subscript":
        object = emit_expression(node["obj"])
        if not object["ok"]:
            return object
        index = emit_expression(node["index"])
        if not index["ok"]:
            return index
        return result(object["code"] + "[" + index["code"] + "]")
    if kind == "List":
        elements = emit_expressions(node["elts"])
        if not elements["ok"]:
            return elements
        return result("[" + elements["code"] + "]")
    if kind == "Map":
        pairs = emit_map_pairs(node["pairs"])
        if not pairs["ok"]:
            return pairs
        return result("{" + pairs["code"] + "}")
    if kind == "PyImport":
        module = emit_expression(node["module_expr"])
        if not module["ok"]:
            return module
        return result("_lt_bootstrap_py_import(" + module["code"] + ")")
    if kind == "JavaImport":
        class_expr = emit_expression(node["class_expr"])
        if not class_expr["ok"]:
            return class_expr
        return result("_lt_bootstrap_jclass(" + class_expr["code"] + ")")
    if kind == "Super":
        return failure("super requires the unavailable class runtime")
    if kind == "SuperCall":
        if len(node["args"]) == 0:
            return failure("super call is missing its receiver")
        receiver = emit_expression(node["args"][0])
        if not receiver["ok"]:
            return receiver
        arguments = []
        for index in range(1, len(node["args"])):
            arguments = arguments + [node["args"][index]]
        emitted_arguments = emit_call_arguments(arguments)
        if not emitted_arguments["ok"]:
            return emitted_arguments
        suffix = ""
        if emitted_arguments["code"] != "":
            suffix = ", " + emitted_arguments["code"]
        return result("_lt_bootstrap_supercall(" + receiver["code"] + ", " + node["owner"] + ", " + quote_string(node["method"]) + suffix + ")")
    return failure("unsupported expression node: " + kind)

fn emit_block(statements, indent):
    output = ""
    for statement in statements:
        emitted = emit_statement(statement, indent)
        if not emitted["ok"]:
            return emitted
        output = output + emitted["code"]
    if output == "":
        output = indent + "pass\n"
    return result(output)

fn emit_class(node, indent, factory_name):
    parent_expression = "None"
    if node["parent"] != nil:
        if node["parent"]["alias"] != nil:
            return failure("qualified class parents require the module linker")
        parent_expression = node["parent"]["name"]
    output = indent + "def " + factory_name + "():\n"
    output = output + indent + "    class _LtBootstrapMethods:\n"
    for method in node["methods"]:
        emitted = emit_statement(method, indent + "        ")
        if not emitted["ok"]:
            return emitted
        output = output + emitted["code"]
    methods = "{"
    first = true
    for method in node["methods"]:
        if first:
            first = false
        else:
            methods = methods + ", "
        methods = methods + quote_string(method["name"]) + ": _LtBootstrapMethods." + method["name"]
    methods = methods + "}"
    output = output + indent + "    return _LtBootstrapClass(" + quote_string(node["source_name"]) + ", " + parent_expression + ", " + methods + ")\n"
    output = output + indent + node["name"] + " = " + factory_name + "()\n"
    return result(output)

fn collect_module_bindings(statements, names):
    for statement in statements:
        kind = statement["type"]
        if kind == "FnDef" or kind == "ClassDef":
            names = names + [statement["name"]]
        elif kind == "ImportStmt":
            names = names + [statement["alias"]]
        elif kind == "Assign" and statement["target"]["type"] == "Name":
            names = names + [statement["target"]["id"]]
        elif kind == "For":
            names = names + [statement["var"]]
            names = collect_module_bindings(statement["body"], names)
        elif kind == "If":
            names = collect_module_bindings(statement["then_body"], names)
            if statement["else_body"] != nil:
                names = collect_module_bindings(statement["else_body"], names)
        elif kind == "While":
            names = collect_module_bindings(statement["body"], names)
        elif kind == "Try":
            names = names + [statement["var"]]
            names = collect_module_bindings(statement["body"], names)
            names = collect_module_bindings(statement["handler"], names)
    return names

fn class_factory_name(class_name, reserved):
    candidate = "_lt_bootstrap_make_class_" + class_name
    while names_have(reserved, candidate):
        candidate = "_" + candidate
    return {"name": candidate, "reserved": reserved + [candidate]}

fn names_have(names, wanted):
    for name in names:
        if name == wanted:
            return true
    return false

fn append_name(names, name):
    if names_have(names, name):
        return names
    return names + [name]

fn collect_scope_names(statements, wanted_kind, names):
    for statement in statements:
        kind = statement["type"]
        if kind == wanted_kind:
            for name in statement["names"]:
                names = append_name(names, name)
        elif kind == "FnDef" or kind == "ClassDef":
            continue
        elif kind == "If":
            names = collect_scope_names(statement["then_body"], wanted_kind, names)
            if statement["else_body"] != nil:
                names = collect_scope_names(statement["else_body"], wanted_kind, names)
        elif kind == "While" or kind == "For":
            names = collect_scope_names(statement["body"], wanted_kind, names)
        elif kind == "Try":
            names = collect_scope_names(statement["body"], wanted_kind, names)
            names = collect_scope_names(statement["handler"], wanted_kind, names)
    return names

fn collect_function_locals(statements, names):
    for statement in statements:
        kind = statement["type"]
        if kind == "Assign" and statement["target"]["type"] == "Name":
            names = append_name(names, statement["target"]["id"])
        elif kind == "ImportStmt":
            names = append_name(names, statement["alias"])
        elif kind == "FnDef" or kind == "ClassDef":
            names = append_name(names, statement["name"])
        elif kind == "If":
            names = collect_function_locals(statement["then_body"], names)
            if statement["else_body"] != nil:
                names = collect_function_locals(statement["else_body"], names)
        elif kind == "While":
            names = collect_function_locals(statement["body"], names)
        elif kind == "For":
            names = append_name(names, statement["var"])
            names = collect_function_locals(statement["body"], names)
        elif kind == "Try":
            names = append_name(names, statement["var"])
            names = collect_function_locals(statement["body"], names)
            names = collect_function_locals(statement["handler"], names)
    return names

fn join_names(names):
    output = ""
    first = true
    for name in names:
        if first:
            first = false
        else:
            output = output + ", "
        output = output + name
    return output

fn order_classes(statements):
    pending = []
    for statement in statements:
        if statement["type"] == "ClassDef":
            pending = pending + [statement]
    ordered = []
    ordered_names = []
    while len(pending) > 0:
        remaining = []
        progressed = false
        for class_node in pending:
            parent = class_node["parent"]
            if parent == nil or names_have(ordered_names, parent["name"]):
                ordered = ordered + [class_node]
                ordered_names = ordered_names + [class_node["name"]]
                progressed = true
            else:
                remaining = remaining + [class_node]
        if not progressed:
            return {"ok": false, "classes": [], "error": "class parent order is unresolved"}
        pending = remaining
    return {"ok": true, "classes": ordered, "error": ""}

fn emit_statement_body(node, indent):
    kind = node["type"]
    if kind == "GlobalStmt" or kind == "NonlocalStmt":
        return result("")
    if kind == "FnDef":
        specs = node["param_specs"]
        fixed_names = []
        collectors = []
        required_keyword_only = []
        positional_count = 0
        required_count = 0
        saw_default = false
        rest_name = "None"
        extra_name = "None"
        for parameter in specs:
            parameter_kind = parameter["type"]
            if parameter_kind == "RestParam":
                rest_name = quote_string(parameter["name"])
                collectors = collectors + [parameter["name"]]
            elif parameter_kind == "ExtraParam":
                extra_name = quote_string(parameter["name"])
                collectors = collectors + [parameter["name"]]
            else:
                fixed_names = fixed_names + [parameter["name"]]
                if parameter_kind == "PositionalParam" or parameter_kind == "DefaultParam":
                    positional_count = positional_count + 1
                    if parameter_kind == "DefaultParam":
                        saw_default = true
                    elif not saw_default:
                        required_count = required_count + 1
                elif parameter_kind == "KeywordOnlyParam" and parameter["default"] == nil:
                    required_keyword_only = required_keyword_only + [parameter["name"]]
        python_names = fixed_names + collectors
        local_names = collect_function_locals(node["body"], [])
        global_names = collect_scope_names(node["body"], "GlobalStmt", [])
        nonlocal_names = collect_scope_names(node["body"], "NonlocalStmt", [])
        scope_declarations = ""
        if len(global_names) > 0:
            scope_declarations = scope_declarations + indent + "    global " + join_names(global_names) + "\n"
        if len(nonlocal_names) > 0:
            scope_declarations = scope_declarations + indent + "    nonlocal " + join_names(nonlocal_names) + "\n"
        local_initializers = ""
        for local_name in local_names:
            if not names_have(python_names, local_name) and not names_have(global_names, local_name) and not names_have(nonlocal_names, local_name):
                local_initializers = local_initializers + indent + "    " + local_name + " = None\n"
        parameters = ""
        first = true
        for parameter in python_names:
            if first:
                first = false
            else:
                parameters = parameters + ", "
            parameters = parameters + parameter
        initializers = ""
        for parameter in specs:
            parameter_kind = parameter["type"]
            if parameter_kind == "DefaultParam" or (parameter_kind == "KeywordOnlyParam" and parameter["default"] != nil):
                default = emit_expression(parameter["default"])
                if not default["ok"]:
                    return default
                initializers = initializers + indent + "    if " + parameter["name"] + " is _lt_bootstrap_missing:\n"
                initializers = initializers + indent + "        " + parameter["name"] + " = " + default["code"] + "\n"
        body = emit_block(node["body"], indent + "    ")
        if not body["ok"]:
            return body
        names_code = "["
        first = true
        for parameter in fixed_names:
            if first:
                first = false
            else:
                names_code = names_code + ", "
            names_code = names_code + quote_string(parameter)
        names_code = names_code + "]"
        keyword_code = "["
        first = true
        for parameter in required_keyword_only:
            if first:
                first = false
            else:
                keyword_code = keyword_code + ", "
            keyword_code = keyword_code + quote_string(parameter)
        keyword_code = keyword_code + "]"
        wrapper = indent + node["name"] + " = _LtBootstrapFunction(" + node["name"] + ", " + names_code + ", " + quote_string(node["name"])
        wrapper = wrapper + ", required_count=" + str(required_count) + ", positional_count=" + str(positional_count)
        wrapper = wrapper + ", required_keyword_only=" + keyword_code + ", rest_name=" + rest_name + ", extra_name=" + extra_name + ")\n"
        return result(indent + "def " + node["name"] + "(" + parameters + "):\n" + scope_declarations + local_initializers + initializers + body["code"] + wrapper)
    if kind == "ClassDef":
        return failure("nested class declarations are not supported by the bootstrap emitter")
    if kind == "Assign":
        target = emit_expression(node["target"])
        if not target["ok"]:
            return target
        value = emit_expression(node["value"])
        if not value["ok"]:
            return value
        return result(indent + target["code"] + " = " + value["code"] + "\n")
    if kind == "ExprStmt":
        expression = emit_expression(node["expr"])
        if not expression["ok"]:
            return expression
        return result(indent + expression["code"] + "\n")
    if kind == "Say":
        expression = emit_expression(node["value"])
        if not expression["ok"]:
            return expression
        return result(indent + "_lt_bootstrap_say(" + expression["code"] + ")\n")
    if kind == "Return":
        if node["value"] == nil:
            return result(indent + "return None\n")
        expression = emit_expression(node["value"])
        if not expression["ok"]:
            return expression
        return result(indent + "return " + expression["code"] + "\n")
    if kind == "If":
        condition = emit_expression(node["cond"])
        if not condition["ok"]:
            return condition
        then_body = emit_block(node["then_body"], indent + "    ")
        if not then_body["ok"]:
            return then_body
        output = indent + "if " + condition["code"] + ":\n" + then_body["code"]
        if node["else_body"] != nil:
            else_body = emit_block(node["else_body"], indent + "    ")
            if not else_body["ok"]:
                return else_body
            output = output + indent + "else:\n" + else_body["code"]
        return result(output)
    if kind == "While":
        condition = emit_expression(node["cond"])
        if not condition["ok"]:
            return condition
        body = emit_block(node["body"], indent + "    ")
        if not body["ok"]:
            return body
        return result(indent + "while " + condition["code"] + ":\n" + body["code"])
    if kind == "For":
        iterable = emit_expression(node["iter"])
        if not iterable["ok"]:
            return iterable
        body = emit_block(node["body"], indent + "    ")
        if not body["ok"]:
            return body
        return result(indent + "for " + node["var"] + " in _lt_bootstrap_iter(" + iterable["code"] + "):\n" + body["code"])
    if kind == "Try":
        body = emit_block(node["body"], indent + "    ")
        if not body["ok"]:
            return body
        handler = emit_block(node["handler"], indent + "    ")
        if not handler["ok"]:
            return handler
        output = indent + node["var"] + " = None\n"
        output = output + indent + "try:\n" + body["code"]
        output = output + indent + "except Exception:\n"
        output = output + indent + "    " + node["var"] + " = _lt_bootstrap_current_exception_message()\n"
        return result(output + handler["code"])
    if kind == "Throw":
        value = emit_expression(node["value"])
        if not value["ok"]:
            return value
        return result(indent + "raise Exception(_lt_bootstrap_str(" + value["code"] + "))\n")
    if kind == "Break":
        return result(indent + "break\n")
    if kind == "Continue":
        return result(indent + "continue\n")
    return failure("unsupported statement node: " + kind)

fn source_marker(node, indent):
    source_value = "None"
    if node["source_id"] != nil:
        source_value = quote_string(node["source_id"])
    return indent + "# __LT_SOURCE__ " + source_value + " " + str(node["line"]) + "\n"

fn unmapped_source_marker(indent):
    return indent + "# __LT_SOURCE__ None 0\n"

fn emit_statement(node, indent):
    emitted = emit_statement_body(node, indent)
    if not emitted["ok"]:
        return emitted
    if emitted["code"] == "":
        return emitted
    return result(source_marker(node, indent) + emitted["code"])

fn runtime_prelude():
    output = "def _lt_bootstrap_repr(value, quoted=False):\n"
    output = output + "    if value is None:\n        return 'nil'\n"
    output = output + "    if value is True:\n        return 'true'\n"
    output = output + "    if value is False:\n        return 'false'\n"
    output = output + "    if isinstance(value, _LtBootstrapClass):\n        return '<class ' + value._name + '>'\n"
    output = output + "    if isinstance(value, _LtBootstrapInstance):\n        return '<' + value._lt_class._name + ' object>'\n"
    output = output + "    if isinstance(value, float):\n        if value.is_integer():\n            return str(int(value))\n        return str(value)\n"
    output = output + "    if isinstance(value, _LtBootstrapModule):\n        return '<module ' + value._name + '>'\n"
    output = output + "    if isinstance(value, str):\n"
    output = output + "        if not quoted:\n            return value\n"
    output = output + "        text = value.replace('\\\\', '\\\\\\\\').replace('\\\"', '\\\\\\\"')\n"
    output = output + "        text = text.replace('\\n', '\\\\n').replace('\\t', '\\\\t').replace('\\r', '\\\\r').replace('\\0', '\\\\0')\n"
    output = output + "        return '\"' + text + '\"'\n"
    output = output + "    if isinstance(value, list):\n        return '[' + ', '.join(_lt_bootstrap_repr(item, True) for item in value) + ']'\n"
    output = output + "    if isinstance(value, dict):\n        return '{' + ', '.join(_lt_bootstrap_repr(key, True) + ': ' + _lt_bootstrap_repr(item, True) for key, item in value.items()) + '}'\n"
    output = output + "    if isinstance(value, _LtBootstrapFunction):\n        if value._display is not None:\n            return value._display\n        return '<function ' + value._name + '>'\n"
    output = output + "    if isinstance(value, tuple):\n        return '[' + ', '.join(_lt_bootstrap_repr(item, True) for item in value) + ']'\n"
    output = output + "    return str(value)\n"
    output = output + "def _lt_bootstrap_eq(left, right):\n"
    output = output + "    if isinstance(left, float) and isinstance(right, float):\n        if left != left or right != right:\n            return False\n        return left == right\n"
    output = output + "    primitive_types = (bool, float, str, list, dict)\n    if not isinstance(left, primitive_types) or not isinstance(right, primitive_types):\n        return left is right\n"
    output = output + "    if type(left) is not type(right):\n        return False\n"
    output = output + "    if isinstance(left, list):\n        return len(left) == len(right) and all(_lt_bootstrap_eq(left[index], right[index]) for index in range(len(left)))\n"
    output = output + "    if isinstance(left, dict):\n        if len(left) != len(right) or any(key not in right for key in left):\n            return False\n        return all(_lt_bootstrap_eq(left[key], right[key]) for key in left)\n"
    output = output + "    return left == right\n\n"
    output = output + "class _LtBootstrapArgumentError(RuntimeError):\n    pass\n\n"
    output = output + "class _LtBootstrapNamedArg:\n    def __init__(self, name, value):\n        self.name = name\n        self.value = value\n\n"
    output = output + "class _LtBootstrapStarArg:\n    def __init__(self, values):\n        self.values = tuple(values)\n\n"
    output = output + "class _LtBootstrapStarStarArg:\n    def __init__(self, items):\n        self.items = tuple(items)\n\n"
    output = output + "def _lt_bootstrap_named(name, value):\n    return _LtBootstrapNamedArg(name, value)\n\n"
    output = output + "def _lt_bootstrap_star(value):\n    if not isinstance(value, list):\n        raise _LtBootstrapArgumentError('* unpacking requires a Latent list')\n    return _LtBootstrapStarArg(value)\n\n"
    output = output + "def _lt_bootstrap_starstar(value):\n    if not isinstance(value, dict):\n        raise _LtBootstrapArgumentError('** unpacking requires a Latent map')\n    items = list(value.items())\n    for key, _ in items:\n        if not isinstance(key, str):\n            raise _LtBootstrapArgumentError('** unpacking requires string keys')\n    return _LtBootstrapStarStarArg(items)\n\n"
    output = output + "def _lt_bootstrap_expand_args(args):\n    expanded = []\n    for arg in args:\n        if isinstance(arg, _LtBootstrapStarArg):\n            expanded.extend(arg.values)\n        elif isinstance(arg, _LtBootstrapStarStarArg):\n            expanded.extend(_LtBootstrapNamedArg(key, value) for key, value in arg.items)\n        else:\n            expanded.append(arg)\n    return expanded\n\n"
    output = output + "def _lt_bootstrap_bind_args(function, args):\n    params = function._params\n    positional_count = function._positional_count\n    args = _lt_bootstrap_expand_args(args)\n    has_named = any(isinstance(arg, _LtBootstrapNamedArg) for arg in args)\n    if not has_named:\n        if len(args) > positional_count and function._rest_name is None:\n            raise _LtBootstrapArgumentError('%s() takes %d args, got %d' % (function._name, positional_count, len(args)))\n        if len(args) < function._required_count:\n            if function._required_count == positional_count:\n                raise _LtBootstrapArgumentError('%s() takes %d args, got %d' % (function._name, positional_count, len(args)))\n            raise _LtBootstrapArgumentError('%s() missing required argument %r' % (function._name, params[len(args)]))\n        values = [function.MISSING] * len(params)\n        for index, value in enumerate(args[:positional_count]):\n            values[index] = value\n        for parameter in function._required_keyword_only:\n            raise _LtBootstrapArgumentError('%s() missing required keyword-only argument %r' % (function._name, parameter))\n        if function._rest_name is not None:\n            values.append(list(args[positional_count:]))\n        if function._extra_name is not None:\n            values.append({})\n        return values\n    values = [function.MISSING] * len(params)\n    supplied = [False] * len(params)\n    rest_values = []\n    extra_values = {}\n    pos = 0\n    seen_names = set()\n    for arg in args:\n        if isinstance(arg, _LtBootstrapNamedArg):\n            if arg.name in seen_names:\n                raise _LtBootstrapArgumentError('%s() got duplicate named argument %r' % (function._name, arg.name))\n            seen_names.add(arg.name)\n            if arg.name not in params:\n                if function._extra_name is None:\n                    raise _LtBootstrapArgumentError('%s() got unexpected named argument %r' % (function._name, arg.name))\n                extra_values[arg.name] = arg.value\n            else:\n                index = params.index(arg.name)\n                if supplied[index]:\n                    raise _LtBootstrapArgumentError('%s() got multiple values for argument %r' % (function._name, arg.name))\n                values[index] = arg.value\n                supplied[index] = True\n        else:\n            if pos >= positional_count:\n                if function._rest_name is None:\n                    raise _LtBootstrapArgumentError('%s() takes %d args, got %d' % (function._name, positional_count, pos + 1))\n                rest_values.append(arg)\n            else:\n                values[pos] = arg\n                supplied[pos] = True\n            pos = pos + 1\n    for index in range(function._required_count):\n        if not supplied[index]:\n            raise _LtBootstrapArgumentError('%s() missing required argument %r' % (function._name, params[index]))\n    for parameter in function._required_keyword_only:\n        index = params.index(parameter)\n        if not supplied[index]:\n            raise _LtBootstrapArgumentError('%s() missing required keyword-only argument %r' % (function._name, parameter))\n    if function._rest_name is not None:\n        values.append(rest_values)\n    if function._extra_name is not None:\n        values.append(extra_values)\n    return values\n\n"
    output = output + "class _LtBootstrapFunction:\n    MISSING = object()\n    def __init__(self, fn, params, name, required_count, positional_count, required_keyword_only, rest_name, extra_name, display=None):\n        self._fn = fn\n        self._params = tuple(params)\n        self._name = name\n        self._required_count = required_count\n        self._positional_count = positional_count\n        self._required_keyword_only = tuple(required_keyword_only)\n        self._rest_name = rest_name\n        self._extra_name = extra_name\n        self._display = display\n    def __call__(self, *args):\n        return self._fn(*_lt_bootstrap_bind_args(self, args))\n\n"
    output = output + "class _LtBootstrapInstance:\n    __slots__ = ('_lt_class', '_lt_fields')\n    def __init__(self, cls):\n        self._lt_class = cls\n        self._lt_fields = {}\n\n"
    output = output + "class _LtBootstrapClass:\n    def __init__(self, name, parent, methods):\n        self._name = name\n        self._parent = parent\n        self._methods = methods\n    def _find_method(self, name):\n        current = self\n        while current is not None:\n            method = current._methods.get(name)\n            if method is not None:\n                return method\n            current = current._parent\n        return None\n    def _new(self, *args):\n        instance = _LtBootstrapInstance(self)\n        initializer = self._find_method('init')\n        if initializer is not None:\n            _lt_bootstrap_bound_method(initializer, instance, name=self._name + '.new')(*args)\n        else:\n            _lt_bootstrap_no_arg_constructor(self._name + '.new', args)\n        return instance\n\n"
    output = output + "def _lt_bootstrap_bound_method(method, receiver, display=None, name=None):\n    return _LtBootstrapFunction(lambda *args: method._fn(receiver, *args), method._params[1:], name or method._name, required_count=method._required_count - 1, positional_count=method._positional_count - 1, required_keyword_only=method._required_keyword_only, rest_name=method._rest_name, extra_name=method._extra_name, display=display)\n\n"
    output = output + "def _lt_bootstrap_supercall(receiver, owner, attr, *args):\n    if not isinstance(receiver, _LtBootstrapInstance) or not isinstance(owner, _LtBootstrapClass):\n        raise TypeError('super call requires a Latent instance and class')\n    current = receiver._lt_class\n    while current is not None and current is not owner:\n        current = current._parent\n    if current is None or owner._parent is None:\n        raise TypeError('super call owner is not in the instance inheritance chain')\n    method = owner._parent._find_method(attr)\n    if method is None:\n        raise AttributeError('no parent method %r on class %s' % (attr, owner._name))\n    return _lt_bootstrap_bound_method(method, receiver)(*args)\n\n"
    output = output + "def _lt_bootstrap_no_arg_constructor(name, args):\n    for argument in _lt_bootstrap_expand_args(args):\n        if isinstance(argument, _LtBootstrapNamedArg):\n            raise _LtBootstrapArgumentError('%s() got unexpected named argument %r' % (name, argument.name))\n        raise _LtBootstrapArgumentError('%s() takes 0 args, got 1' % name)\n\n"
    output = output + "_lt_bootstrap_missing = _LtBootstrapFunction.MISSING\n"
    output = output + "_lt_bootstrap_callback_threading = __import__('threading')\n_lt_bootstrap_callback_inspect = __import__('inspect')\n_lt_bootstrap_callback_local = _lt_bootstrap_callback_threading.local()\n"
    output = output + "class _LtBootstrapCallbackScope:\n    def __init__(self):\n        self.owner = _lt_bootstrap_callback_threading.get_ident()\n        self.active = True\n        self.adapters = []\n    def close(self):\n        self.active = False\n        for adapter in self.adapters:\n            adapter.function = None\n        self.adapters.clear()\n\n"
    output = output + "def _lt_bootstrap_is_latent_callable(value):\n    return isinstance(value, (_LtBootstrapFunction, _LtBootstrapCallback, _LtBootstrapInteropBoundMethod, _LtBootstrapInteropModuleFunction, _LtBootstrapInteropStaticMethod))\n"
    output = output + "def _lt_bootstrap_deferred(value):\n    return (_lt_bootstrap_callback_inspect.isawaitable(value) or _lt_bootstrap_callback_inspect.isgenerator(value) or _lt_bootstrap_callback_inspect.isasyncgen(value))\n"
    output = output + "def _lt_bootstrap_reject_deferred(value):\n    if _lt_bootstrap_deferred(value):\n        if _lt_bootstrap_callback_inspect.iscoroutine(value):\n            value.close()\n        raise TypeError('synchronous host callbacks do not support async or deferred results')\n    return value\n\n"
    output = output + "def _lt_bootstrap_callback_to_latent(value, ancestors=None, depth=0):\n    if depth > 64:\n        raise TypeError('host callback container nesting exceeds 64 levels')\n    if _lt_bootstrap_is_latent_callable(value):\n        raise TypeError('nested or returned Latent callbacks are unsupported')\n    if isinstance(value, bool) or value is None or isinstance(value, (float, str)):\n        return value\n    if isinstance(value, int):\n        return float(value)\n    if type(value) not in (list, tuple, dict):\n        return value\n    if ancestors is None:\n        ancestors = set()\n    identity = id(value)\n    if identity in ancestors:\n        raise TypeError('cyclic host callback containers are unsupported')\n    ancestors.add(identity)\n    try:\n        if type(value) in (list, tuple):\n            return [_lt_bootstrap_callback_to_latent(item, ancestors, depth + 1) for item in value]\n        converted = {}\n        for key, item in value.items():\n            _lt_bootstrap_callback_to_latent(key, ancestors, depth + 1)\n            converted[key] = _lt_bootstrap_callback_to_latent(item, ancestors, depth + 1)\n        return converted\n    finally:\n        ancestors.remove(identity)\n\n"
    output = output + "def _lt_bootstrap_callback_to_host(value, ancestors=None, depth=0):\n    if depth > 64:\n        raise TypeError('callback result container nesting exceeds 64 levels')\n    _lt_bootstrap_reject_deferred(value)\n    if _lt_bootstrap_is_latent_callable(value):\n        raise TypeError('callbacks cannot return Latent callable values')\n    if callable(value):\n        raise TypeError('callbacks cannot return callable values')\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, float) and value.is_integer() and abs(value) < 1e18:\n        if value != 0.0 or __import__('math').copysign(1.0, value) > 0:\n            return int(value)\n    if type(value) not in (list, tuple, dict):\n        return value\n    if ancestors is None:\n        ancestors = set()\n    identity = id(value)\n    if identity in ancestors:\n        raise TypeError('cyclic callback result containers are unsupported')\n    ancestors.add(identity)\n    try:\n        if type(value) in (list, tuple):\n            return [_lt_bootstrap_callback_to_host(item, ancestors, depth + 1) for item in value]\n        converted = {}\n        for key, item in value.items():\n            _lt_bootstrap_callback_to_host(key, ancestors, depth + 1)\n            converted[key] = _lt_bootstrap_callback_to_host(item, ancestors, depth + 1)\n        return converted\n    finally:\n        ancestors.remove(identity)\n\n"
    output = output + "def _lt_bootstrap_callback_pyarg(value, ancestors=None, depth=0):\n    if depth > 64:\n        raise TypeError('host argument container nesting exceeds 64 levels')\n    if _lt_bootstrap_is_latent_callable(value):\n        raise TypeError('Latent callable values cannot be passed to Python/Java interop calls')\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, float) and value.is_integer() and abs(value) < 1e18:\n        if value != 0.0 or __import__('math').copysign(1.0, value) > 0:\n            return int(value)\n    if type(value) not in (list, tuple, dict):\n        return value\n    if ancestors is None:\n        ancestors = set()\n    identity = id(value)\n    if identity in ancestors:\n        raise TypeError('cyclic host argument containers are unsupported')\n    ancestors.add(identity)\n    try:\n        if type(value) in (list, tuple):\n            return [_lt_bootstrap_callback_pyarg(item, ancestors, depth + 1) for item in value]\n        converted = {}\n        for key, item in value.items():\n            _lt_bootstrap_callback_pyarg(key, ancestors, depth + 1)\n            converted[key] = _lt_bootstrap_callback_pyarg(item, ancestors, depth + 1)\n        return converted\n    finally:\n        ancestors.remove(identity)\n\n"
    output = output + "class _LtBootstrapCallback:\n    def __init__(self, function, scope):\n        self.function = function\n        self.scope = scope\n        scope.adapters.append(self)\n    def __call__(self, *args, **kwargs):\n        scope = self.scope\n        if not scope.active or self.function is None:\n            raise TypeError('host callback scope expired; retained callbacks are unsupported')\n        if _lt_bootstrap_callback_threading.get_ident() != scope.owner:\n            raise TypeError('cross-thread host callbacks are unsupported')\n        depth = getattr(_lt_bootstrap_callback_local, 'depth', 0)\n        if depth >= 16:\n            raise TypeError('host callback nesting exceeds 16 levels')\n        function = self.function\n        _lt_bootstrap_callback_local.depth = depth + 1\n        try:\n            latent_args = [_lt_bootstrap_callback_to_latent(arg) for arg in args]\n            latent_args.extend(_LtBootstrapNamedArg(name, _lt_bootstrap_callback_to_latent(value)) for name, value in kwargs.items())\n            result = _lt_bootstrap_call(function, *latent_args)\n            _lt_bootstrap_reject_deferred(result)\n            return _lt_bootstrap_callback_to_host(result)\n        finally:\n            _lt_bootstrap_callback_local.depth = depth\n\n"
    output = output + "def _lt_bootstrap_host_call(function, args):\n    seen_names = set()\n    has_callback = False\n    for argument in args:\n        if isinstance(argument, (_LtBootstrapStarArg, _LtBootstrapStarStarArg)):\n            raise _LtBootstrapArgumentError('argument unpacking is not supported for Python/Java interop calls')\n        if isinstance(argument, _LtBootstrapNamedArg):\n            if argument.name in seen_names:\n                raise _LtBootstrapArgumentError('got duplicate named argument %r' % argument.name)\n            seen_names.add(argument.name)\n            value = argument.value\n        else:\n            value = argument\n        if isinstance(value, _LtBootstrapFunction):\n            has_callback = True\n    if not has_callback:\n        converted_args = []\n        converted_kwargs = {}\n        for argument in args:\n            if isinstance(argument, _LtBootstrapNamedArg):\n                converted_kwargs[argument.name] = _lt_bootstrap_callback_pyarg(argument.value)\n            else:\n                converted_args.append(_lt_bootstrap_callback_pyarg(argument))\n        return function(*converted_args, **converted_kwargs)\n    # A normal Python callable cannot reveal when it stores or schedules an adapter.\n    scope = _LtBootstrapCallbackScope()\n    try:\n        converted_args = []\n        converted_kwargs = {}\n        for argument in args:\n            named = isinstance(argument, _LtBootstrapNamedArg)\n            value = argument.value if named else argument\n            if isinstance(value, _LtBootstrapFunction):\n                converted = _LtBootstrapCallback(value, scope)\n            else:\n                converted = _lt_bootstrap_callback_to_host(value)\n            if named:\n                converted_kwargs[argument.name] = converted\n            else:\n                converted_args.append(converted)\n        result = function(*converted_args, **converted_kwargs)\n        _lt_bootstrap_reject_deferred(result)\n        _lt_bootstrap_callback_to_host(result)\n        return result\n    finally:\n        scope.close()\n\n"
    output = output + "def _lt_bootstrap_call(function, *args):\n    if isinstance(function, _LtBootstrapFunction):\n        return function(*args)\n    if not callable(function):\n        raise TypeError('call on non-function value')\n    if any(isinstance(arg, _LtBootstrapNamedArg) for arg in args):\n        raise _LtBootstrapArgumentError('named arguments are not supported for non-Latent calls')\n    if any(isinstance(arg, (_LtBootstrapStarArg, _LtBootstrapStarStarArg)) for arg in args):\n        raise _LtBootstrapArgumentError('argument unpacking is not supported for non-Latent calls')\n    return _lt_bootstrap_host_call(function, args)\n\n"
    output = output + "def _lt_bootstrap_wgetattr(value, name):\n    if isinstance(value, _LtBootstrapInstance):\n        if name in value._lt_fields:\n            return value._lt_fields[name]\n        method = value._lt_class._find_method(name)\n        if method is not None:\n            display = '<bound method ' + value._lt_class._name + '.' + name + '>'\n            return _lt_bootstrap_bound_method(method, value, display=display)\n        raise AttributeError('no field %r' % name)\n    if isinstance(value, _LtBootstrapClass):\n        raise AttributeError('class %s has no fields' % value._name)\n    return getattr(value, name)\n\n"
    output = output + "def _lt_bootstrap_wcall(value, name, *args):\n    if isinstance(value, _LtBootstrapClass):\n        if name == 'new':\n            return value._new(*args)\n        raise AttributeError('no class-level method %r' % name)\n    if isinstance(value, _LtBootstrapInstance):\n        method = value._lt_class._find_method(name)\n        if method is None:\n            raise AttributeError('no method %r' % name)\n        return _lt_bootstrap_bound_method(method, value)(*args)\n    if any(isinstance(arg, (_LtBootstrapNamedArg, _LtBootstrapStarArg, _LtBootstrapStarStarArg)) for arg in args):\n        raise _LtBootstrapArgumentError('named arguments and unpacking are not yet supported for Python/Java interop calls')\n    return _lt_bootstrap_host_call(getattr(value, name), args)\n\n"
    output = output + "def _lt_bootstrap_wsetattr(value, name, item):\n    if isinstance(value, _LtBootstrapInstance):\n        value._lt_fields[name] = item\n        return None\n    if isinstance(value, _LtBootstrapClass):\n        raise AttributeError('cannot set attribute on a class')\n    if isinstance(value, _LtBootstrapModule):\n        raise AttributeError('cannot set attribute on a module')\n    raise AttributeError('attribute assignment on non-Latent objects is not supported')\n\n"
    output = output + "def _lt_bootstrap_say(value):\n    print(_lt_bootstrap_repr(value))\n\n"
    output = output + "def _lt_bootstrap_str(value):\n    return _lt_bootstrap_repr(value)\n\n"
    output = output + "def _lt_bootstrap_index(value, key):\n"
    output = output + "    if isinstance(value, (list, str)):\n"
    output = output + "        if isinstance(key, bool) or not isinstance(key, float) or not key.is_integer():\n            raise TypeError('index must be an integer')\n"
    output = output + "        index = int(key)\n        if index < 0:\n            index += len(value)\n        if index < 0 or index >= len(value):\n            raise IndexError('index out of range: ' + str(int(key)))\n        return value[index]\n"
    output = output + "    if isinstance(value, dict):\n        if key not in value:\n            raise KeyError('key not found: ' + _lt_bootstrap_repr(key))\n        return value[key]\n"
    output = output + "    raise TypeError('cannot index ' + _lt_bootstrap_repr(value))\n\n"
    output = output + "def _lt_bootstrap_wsetindex(value, key, item):\n"
    output = output + "    if isinstance(value, list):\n        if isinstance(key, bool) or not isinstance(key, float) or not key.is_integer():\n            raise TypeError('index must be an integer')\n        index = int(key)\n        if index < 0:\n            index += len(value)\n        if index < 0 or index >= len(value):\n            raise IndexError('index out of range: ' + str(int(key)))\n        value[index] = item\n        return None\n"
    output = output + "    if isinstance(value, dict):\n        value[key] = item\n        return None\n"
    output = output + "    raise TypeError('cannot index-assign ' + _lt_bootstrap_repr(value))\n\n"
    output = output + "class _LtBootstrapModule:\n    def __init__(self, name):\n        self._name = name\n        self._module = None\n    def _load(self):\n        if self._module is None:\n            import importlib\n            self._module = importlib.import_module(self._name)\n        return self._module\n    def __getattr__(self, name):\n        if name.startswith('__'):\n            raise AttributeError(name)\n        return getattr(self._load(), name)\n\n"
    output = output + "def _lt_bootstrap_py_import(name):\n    if not isinstance(name, str):\n        raise TypeError('py module name must be a string')\n    return _LtBootstrapModule(name)\n\n"
    output = output + "def _lt_bootstrap_keys(value):\n    if not isinstance(value, dict):\n        raise TypeError('keys() expects a map')\n    return list(value.keys())\n\n"
    output = output + "def _lt_bootstrap_push(values, item):\n    if not isinstance(values, list):\n        raise TypeError('push() expects a list')\n    values.append(item)\n    return None\n\n"
    output = output + "def _lt_bootstrap_range(*args):\n    return list(range(*args))\n\n"
    output = output + "def _lt_bootstrap_current_exception_message():\n    error = __import__('sys').exc_info()[1]\n    if error.args and isinstance(error.args[0], str):\n        return error.args[0]\n    return str(error)\n\n"
    output = output + "__say = _lt_bootstrap_say\n__index = _lt_bootstrap_index\n__wsetindex = _lt_bootstrap_wsetindex\n"
    output = output + java_runtime.emitted_prelude()
    output = output + "_lt_bootstrap_projected_call = _lt_bootstrap_call\n_lt_bootstrap_projected_wcall = _lt_bootstrap_wcall\n"
    output = output + "def _lt_bootstrap_call(function, *args):\n    if isinstance(function, _LtBootstrapFunction):\n        return function(*args)\n    if isinstance(function, _LtBootstrapInteropBoundMethod):\n        if function._kind == 'python':\n            return _lt_bootstrap_host_call(function._target, args)\n        return _lt_bootstrap_projected_call(function, *args)\n    if isinstance(function, _LtBootstrapInteropModuleFunction):\n        return _lt_bootstrap_host_call(function._function, args)\n    if isinstance(function, _LtBootstrapInteropStaticMethod):\n        return _lt_bootstrap_projected_call(function, *args)\n    return _lt_bootstrap_projected_call(function, *args)\n\n"
    output = output + "def _lt_bootstrap_wcall(value, name, *args):\n    if isinstance(value, (_LtBootstrapJavaClass, _LtBootstrapJavaHandle, _LtBootstrapClass, _LtBootstrapInstance)):\n        return _lt_bootstrap_projected_wcall(value, name, *args)\n    return _lt_bootstrap_host_call(getattr(value, name), args)\n\n"
    output = output + "def _lt_bootstrap_source_location(generated_file, target_line):\n"
    output = output + "    marker = '# __LT_SOURCE__ '\n"
    output = output + "    current = None\n"
    output = output + "    with open(generated_file, encoding='utf-8') as stream:\n"
    output = output + "        for line_number, line in enumerate(stream, 1):\n"
    output = output + "            if line_number > target_line:\n                break\n"
    output = output + "            candidate = line.lstrip()\n"
    output = output + "            if not candidate.startswith(marker):\n                continue\n"
    output = output + "            payload = candidate[len(marker):].strip()\n"
    output = output + "            split_at = payload.rfind(' ')\n"
    output = output + "            if split_at < 0:\n                current = None\n                continue\n"
    output = output + "            try:\n"
    output = output + "                source_id = __import__('ast').literal_eval(payload[:split_at])\n"
    output = output + "                source_line = int(payload[split_at + 1:])\n"
    output = output + "                current = None if source_id is None else (source_id, source_line)\n"
    output = output + "            except Exception:\n                current = None\n"
    output = output + "    return current\n\n"
    output = output + "def _lt_bootstrap_report_uncaught(error, generated_file):\n"
    output = output + "    def fallback():\n        __import__('traceback').print_exception(type(error), error, error.__traceback__, file=__import__('sys').stderr)\n"
    output = output + "    try:\n"
    output = output + "        generated_abs = __import__('os').path.abspath(generated_file)\n"
    output = output + "        mapped = []\n        tb = error.__traceback__\n"
    output = output + "        while tb is not None:\n"
    output = output + "            frame = tb.tb_frame\n            filename = frame.f_code.co_filename\n"
    output = output + "            if filename == generated_file or __import__('os').path.abspath(filename) == generated_abs:\n"
    output = output + "                location = _lt_bootstrap_source_location(generated_file, tb.tb_lineno)\n"
    output = output + "                if location is not None:\n"
    output = output + "                    frame_name = frame.f_code.co_name\n                    if frame_name == '<module>':\n                        frame_name = 'main'\n"
    output = output + "                    mapped.append((location[0], location[1], frame_name))\n"
    output = output + "            tb = tb.tb_next\n"
    output = output + "        if not mapped:\n            fallback()\n            return\n"
    output = output + "        message = str(error)\n"
    output = output + "        if isinstance(error, _LtBootstrapArgumentError):\n            error_type = 'ArgumentError'\n"
    output = output + "        elif isinstance(error, _LtBootstrapJavaInteropError):\n            error_type = 'RuntimeException'\n"
    output = output + "        else:\n            error_type = type(error).__name__\n"
    output = output + "        detail = error_type + (': ' + message if message else '')\n"
    output = output + "        stream = __import__('sys').stderr\n"
    output = output + "        stream.write('Latent runtime error: ' + detail + '\\n')\n"
    output = output + "        stream.write('Latent traceback (most recent call last):\\n')\n"
    output = output + "        for source_file, source_line, frame_name in mapped:\n"
    output = output + "            stream.write('  at ' + source_file + ':' + str(source_line) + ' in ' + frame_name + '\\n')\n"
    output = output + "    except Exception:\n"
    output = output + "        try:\n            fallback()\n"
    output = output + "        except Exception:\n            __import__('sys').stderr.write('Latent runtime error (diagnostic formatting failed)\\n')\n\n"
    return output

fn generate(tree):
    if tree["type"] != "Program":
        return failure("unsupported root node: " + tree["type"])
    declarations = ""
    body_statements = []
    reserved = collect_module_bindings(tree["stmts"], [])
    ordered = order_classes(tree["stmts"])
    if not ordered["ok"]:
        return failure(ordered["error"])
    for statement in tree["stmts"]:
        if statement["type"] == "FnDef":
            emitted = emit_statement(statement, "")
            if not emitted["ok"]:
                return emitted
            declarations = declarations + emitted["code"] + "\n"
        else:
            if statement["type"] != "ClassDef":
                body_statements = body_statements + [statement]
    for statement in ordered["classes"]:
        allocated = class_factory_name(statement["name"], reserved)
        reserved = allocated["reserved"]
        emitted = emit_class(statement, "", allocated["name"])
        if not emitted["ok"]:
            return emitted
        declarations = declarations + source_marker(statement, "") + emitted["code"] + "\n"
    body_code = ""
    execution = ""
    if len(body_statements) > 0:
        body = emit_block(body_statements, "        ")
        if not body["ok"]:
            return body
        body_code = body["code"]
        execution = "\n" + unmapped_source_marker("") + "if __name__ == \"__main__\":\n    try:\n" + body_code
        execution = execution + "    except Exception as _lt_bootstrap_error:\n        _lt_bootstrap_report_uncaught(_lt_bootstrap_error, __file__)\n        raise SystemExit(1)\n"
    return result(runtime_prelude() + declarations + execution)


fn module_by_source_id(metadata, source_id):
    for module in metadata:
        if module["source_id"] == source_id:
            return module
    return nil

fn join_python_names(names):
    output = ""
    first = true
    for name in names:
        if first:
            first = false
        else:
            output = output + ", "
        output = output + name
    return output

fn generate_modules(tree, metadata, root_id):
    if tree["type"] != "Program":
        return failure("unsupported root node: " + tree["type"])
    ordered_classes = order_classes(tree["stmts"])
    if not ordered_classes["ok"]:
        return failure(ordered_classes["error"])
    reserved = collect_module_bindings(tree["stmts"], [])
    output = runtime_prelude()
    for module in metadata:
        for name in module["globals"]:
            output = output + name + " = None\n"
    output = output + "\n"
    for statement in tree["stmts"]:
        if statement["type"] == "FnDef":
            emitted = emit_statement(statement, "")
            if not emitted["ok"]:
                return emitted
            output = output + "\n" + emitted["code"]
    for module in metadata:
        output = output + "\n" + unmapped_source_marker("") + module["state_name"] + " = 0\n"
        output = output + "def " + module["init_name"] + "():\n"
        output = output + unmapped_source_marker("    ")
        global_names = [module["state_name"]]
        for name in module["globals"]:
            global_names = global_names + [name]
        output = output + "    global " + join_python_names(global_names) + "\n"
        output = output + "    if " + module["state_name"] + " == 2:\n        return\n"
        output = output + "    if " + module["state_name"] + " == 1:\n        raise RuntimeError(\"cyclic module initialization\")\n"
        output = output + "    " + module["state_name"] + " = 1\n"
        output = output + "    try:\n"
        for imported_id in module["imports"]:
            dependency = module_by_source_id(metadata, imported_id)
            if dependency == nil:
                return failure("module linker produced unresolved dependency " + imported_id)
            output = output + "        " + dependency["init_name"] + "()\n"
        for class_node in ordered_classes["classes"]:
            if class_node["source_id"] == module["source_id"]:
                allocated = class_factory_name(class_node["name"], reserved)
                reserved = allocated["reserved"]
                emitted_class = emit_class(class_node, "        ", allocated["name"])
                if not emitted_class["ok"]:
                    return emitted_class
                output = output + source_marker(class_node, "        ") + emitted_class["code"]
        body = []
        for statement in tree["stmts"]:
            if statement["source_id"] == module["source_id"] and statement["type"] != "FnDef" and statement["type"] != "ClassDef":
                body = body + [statement]
        emitted_body = emit_block(body, "        ")
        if not emitted_body["ok"]:
            return emitted_body
        output = output + emitted_body["code"]
        output = output + unmapped_source_marker("        ")
        output = output + "        " + module["state_name"] + " = 2\n"
        output = output + unmapped_source_marker("    ")
        output = output + "    except Exception:\n        " + module["state_name"] + " = 0\n        raise\n"
    root_module = module_by_source_id(metadata, root_id)
    if root_module == nil:
        return failure("module linker did not provide root initializer")
    output = output + "\n" + unmapped_source_marker("") + "if __name__ == \"__main__\":\n    try:\n        " + root_module["init_name"] + "()\n"
    output = output + "    except Exception as _lt_bootstrap_error:\n        _lt_bootstrap_report_uncaught(_lt_bootstrap_error, __file__)\n        raise SystemExit(1)\n"
    return result(output)
