    output = output + "def _lt_bootstrap_reject_interop_args(args):\n"
    output = output + "    if any(isinstance(arg, _LtBootstrapNamedArg) for arg in args):\n"
    output = output + "        raise _LtBootstrapArgumentError(\n"
    output = output + "            \"named arguments are not supported for Python/Java interop calls\")\n"
    output = output + "    if any(isinstance(arg, (_LtBootstrapStarArg, _LtBootstrapStarStarArg))\n"
