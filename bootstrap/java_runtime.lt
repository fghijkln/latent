    output = output + "            entries.append([str(key), _lt_bootstrap_java_encode(item)])\n"
    output = output + "        return {\"__map\": entries}\n"
    output = output + "    raise TypeError(\"cannot send to JVM: \" + _lt_bootstrap_repr(value))\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_java_decode(value):\n"
    output = output + "    if isinstance(value, dict):\n"
