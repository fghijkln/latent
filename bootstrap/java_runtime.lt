    output = output + "    if isinstance(value, bool):\n"
    output = output + "        return value\n"
    output = output + "    if isinstance(value, float) and value.is_integer() and abs(value) < 1e18:\n"
    output = output + "        if value != 0.0 or _lt_bootstrap_math.copysign(1.0, value) > 0:\n"
    output = output + "            return int(value)\n"
    output = output + "    if isinstance(value, list):\n"
