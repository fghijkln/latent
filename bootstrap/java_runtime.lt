    output = output + "            for pair in raw:\n"
    output = output + "                if not isinstance(pair, list) or len(pair) != 2:\n"
    output = output + "                    raise ValueError(\"invalid JVM map entry\")\n"
    output = output + "                result[str(pair[0])] = _lt_bootstrap_java_decode(pair[1])\n"
    output = output + "            return result\n"
    output = output + "        if len(value) == 1 and \"__jref\" in value:\n"
    output = output + "            return _LtBootstrapJavaHandle(value[\"__jref\"])\n"
    output = output + "        if len(value) == 1 and \"__jclass\" in value:\n"
    output = output + "            return _LtBootstrapJavaClass(value[\"__jclass\"])\n"
