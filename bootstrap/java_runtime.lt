    output = output + "        return result\n"
    output = output + "    return value\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_java_encode(value):\n"
    output = output + "    callable_types = (_LtBootstrapFunction, _LtBootstrapInteropBoundMethod,\n"
    output = output + "                      _LtBootstrapInteropModuleFunction,\n"
    output = output + "                      _LtBootstrapInteropStaticMethod)\n"
    output = output + "    if isinstance(value, callable_types):\n"
    output = output + "        raise TypeError(\n"
