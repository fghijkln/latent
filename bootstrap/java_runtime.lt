    output = output + "_lt_bootstrap_base_wgetattr = _lt_bootstrap_wgetattr\n"
    output = output + "_lt_bootstrap_base_wcall = _lt_bootstrap_wcall\n"
    output = output + "_lt_bootstrap_base_wsetattr = _lt_bootstrap_wsetattr\n"
    output = output + "_lt_bootstrap_base_index = _lt_bootstrap_index\n"
    output = output + "_lt_bootstrap_base_wsetindex = _lt_bootstrap_wsetindex\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_host_result(value, depth=0):\n"
    output = output + "    if depth > 64:\n        raise TypeError('Python result container nesting exceeds 64 levels')\n"
    output = output + "    if isinstance(value, bool) or value is None or isinstance(value, (float, str)):\n        return value\n"
    output = output + "    if _lt_bootstrap_builtins.type(value) is _lt_bootstrap_builtins.int:\n        return _lt_bootstrap_checked_int(value)\n"
    output = output + "    if _lt_bootstrap_builtins.type(value) is _lt_bootstrap_builtins.list:\n        return [_lt_bootstrap_host_result(item, depth + 1) for item in value]\n"
    output = output + "    if _lt_bootstrap_builtins.type(value) is _lt_bootstrap_builtins.tuple:\n        return tuple(_lt_bootstrap_host_result(item, depth + 1) for item in value)\n"
    output = output + "    if _lt_bootstrap_builtins.type(value) is _lt_bootstrap_builtins.dict:\n        return {_lt_bootstrap_host_result(key, depth + 1): _lt_bootstrap_host_result(item, depth + 1) for key, item in value.items()}\n"
    output = output + "    return value\n"
    output = output + "_lt_bootstrap_base_callback_to_latent = _lt_bootstrap_callback_to_latent\n"
    output = output + "def _lt_bootstrap_callback_to_latent(value, ancestors=None, depth=0):\n"
    output = output + "    if isinstance(value, int) and not isinstance(value, bool):\n        return _lt_bootstrap_checked_int(value)\n"
    output = output + "    return _lt_bootstrap_base_callback_to_latent(value, ancestors, depth)\n"
    output = output + "_lt_bootstrap_base_java_encode = _lt_bootstrap_java_encode\n"
    output = output + "def _lt_bootstrap_java_encode(value):\n"
    output = output + "    if _lt_bootstrap_is_int(value):\n        return _lt_bootstrap_checked_int(value)\n"
    output = output + "    return _lt_bootstrap_base_java_encode(value)\n"
    output = output + "_lt_bootstrap_base_java_decode = _lt_bootstrap_java_decode\n"
    output = output + "def _lt_bootstrap_java_decode(value):\n"
    output = output + "    if isinstance(value, int) and not isinstance(value, bool):\n        return _lt_bootstrap_checked_int(value)\n"
    output = output + "    return _lt_bootstrap_base_java_decode(value)\n"
    output = output + "def _lt_bootstrap_call(function, *args):\n"
    output = output + "    return _lt_bootstrap_host_result(_lt_bootstrap_base_call(function, *args))\n"
    output = output + "def _lt_bootstrap_range(start, stop=None):\n"
    output = output + "    if stop is None:\n        start, stop = 0, start\n"
    output = output + "    def endpoint(value):\n"
    output = output + "        if _lt_bootstrap_is_int(value):\n            return value\n"
    output = output + "        if not isinstance(value, float):\n            raise TypeError('number expected, got ' + _lt_bootstrap_repr(value))\n"
    output = output + "        if not _lt_bootstrap_math.isfinite(value):\n            raise _LtBootstrapArgumentError('range() arguments must be finite')\n"
    output = output + "        result = _lt_bootstrap_builtins.int(_lt_bootstrap_math.trunc(value))\n"
    output = output + "        if result < _lt_bootstrap_int_min or result > _lt_bootstrap_int_max:\n            raise _LtBootstrapArgumentError('range() arguments outside signed 64-bit range')\n"
    output = output + "        return result\n"
    output = output + "    first, last = endpoint(start), endpoint(stop)\n"
    output = output + "    if last <= first:\n        return []\n"
    output = output + "    if last - first > 1000000:\n        raise _LtBootstrapArgumentError('range() result too large (maximum 1000000 items)')\n"
    output = output + "    return list(_lt_bootstrap_builtins.range(first, last))\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_len(value):\n"
    output = output + "    if isinstance(value, (list, dict, str)):\n"
    output = output + "        return _lt_bootstrap_builtins.len(value)\n"
    output = output + "    raise TypeError(\"len() of \" + _lt_bootstrap_repr(value))\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_int(value):\n"
    output = output + "    if isinstance(value, bool):\n        return _lt_bootstrap_builtins.int(value)\n"
    output = output + "    if _lt_bootstrap_is_int(value):\n        return value\n"
    output = output + "    if isinstance(value, float):\n"
    output = output + "        if not _lt_bootstrap_math.isfinite(value):\n            raise _LtBootstrapArgumentError('int() of ' + _lt_bootstrap_repr(value))\n"
    output = output + "        return _lt_bootstrap_checked_int(_lt_bootstrap_builtins.int(_lt_bootstrap_math.trunc(value)))\n"
    output = output + "    if isinstance(value, str):\n"
    output = output + "        text = value.strip(' \\t\\n\\r\\f\\v')\n"
    output = output + "        digits = text[1:] if text.startswith(('+', '-')) else text\n"
    output = output + "        if not digits or any(ch < '0' or ch > '9' for ch in digits):\n            raise _LtBootstrapArgumentError('invalid literal for int()')\n"
    output = output + "        significant = digits.lstrip('0') or '0'\n"
    output = output + "        limit = '9223372036854775808' if text.startswith('-') else '9223372036854775807'\n"
    output = output + "        if len(significant) > 19 or (len(significant) == 19 and significant > limit):\n            raise OverflowError('int64 overflow')\n"
    output = output + "        normalized = ('-' if text.startswith('-') else '') + significant\n"
    output = output + "        return _lt_bootstrap_builtins.int(normalized, 10)\n"
    output = output + "    raise TypeError('int() of ' + _lt_bootstrap_repr(value))\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_pow(left, right):\n"
    output = output + "    if _lt_bootstrap_is_int(left) and _lt_bootstrap_is_int(right) and right >= 0:\n"
    output = output + "        return _lt_bootstrap_base_pow(left, right)\n"
    output = output + "    if _lt_bootstrap_is_int(left) and _lt_bootstrap_is_int(right):\n"
    output = output + "        x, y = _lt_bootstrap_float_exact(left), _lt_bootstrap_float_exact(right)\n"
    output = output + "    else:\n        x, y = _lt_bootstrap_numeric_pair(left, right, '**')\n"
    output = output + "    if x < 0 and _lt_bootstrap_math.isfinite(y) and not y.is_integer():\n        return _lt_bootstrap_math.nan\n"
    output = output + "    if abs(x) == 1.0 and not _lt_bootstrap_math.isfinite(y):\n        return _lt_bootstrap_math.nan\n"
    output = output + "    if x == 0 and y < 0:\n"
    output = output + "        odd = (_lt_bootstrap_math.copysign(1.0, x) < 0 and y.is_integer() and _lt_bootstrap_builtins.int(abs(y)) % 2 == 1)\n"
    output = output + "        return -_lt_bootstrap_math.inf if odd else _lt_bootstrap_math.inf\n"
    output = output + "    try:\n        return _lt_bootstrap_math.pow(x, y)\n"
    output = output + "    except OverflowError:\n"
    output = output + "        odd = x < 0 and y.is_integer() and _lt_bootstrap_builtins.int(abs(y)) % 2 == 1\n"
    output = output + "        return -_lt_bootstrap_math.inf if odd else _lt_bootstrap_math.inf\n"
    output = output + "    except ValueError:\n        return _lt_bootstrap_math.nan\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_jclass(name):\n"
    output = output + "    if not isinstance(name, str):\n"
    output = output + "        raise TypeError(\"java class name must be a string\")\n"
    output = output + "    return _LtBootstrapJavaClass(name)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_repr(value, quoted=False):\n"
    output = output + "    if isinstance(value, _LtBootstrapJavaClass):\n"
    output = output + "        return \"<class \" + value._name + \">\"\n"
    output = output + "    if isinstance(value, _LtBootstrapJavaHandle):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"repr\", \"target\": jvm.target(value)})\n"
    output = output + "    if isinstance(value, (_LtBootstrapInteropBoundMethod,\n"
    output = output + "                          _LtBootstrapInteropModuleFunction,\n"
    output = output + "                          _LtBootstrapInteropStaticMethod)):\n"
    output = output + "        return value._display\n"
    output = output + "    return _lt_bootstrap_base_repr(value, quoted)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_module_function(module_handle, name):\n"
    output = output + "    module = module_handle._load()\n"
    output = output + "    value = getattr(module, name)\n"
    output = output + "    namespace = vars(module)\n"
    output = output + "    if (_lt_bootstrap_builtins.type(module) is _lt_bootstrap_types.ModuleType and\n"
    output = output + "            name in namespace and namespace[name] is value and\n"
    output = output + "            (_lt_bootstrap_builtins.type(value) is _lt_bootstrap_types.FunctionType or\n"
    output = output + "             (_lt_bootstrap_builtins.type(value) is _lt_bootstrap_types.BuiltinFunctionType and\n"
    output = output + "              module.__name__ != \"builtins\" and value.__self__ is module))):\n"
    output = output + "        return _LtBootstrapInteropModuleFunction(\n"
    output = output + "            value, \"<module function %s.%s>\" % (module.__name__, name))\n"
    output = output + "    return value\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_python_bound_method(receiver, name, value):\n"
    output = output + "    try:\n"
    output = output + "        descriptor = _lt_bootstrap_inspect.getattr_static(receiver, name)\n"
    output = output + "    except AttributeError:\n"
    output = output + "        return None\n"
    output = output + "    if _lt_bootstrap_builtins.type(descriptor) is _lt_bootstrap_types.FunctionType:\n"
    output = output + "        if (_lt_bootstrap_builtins.type(value) is not _lt_bootstrap_types.MethodType or\n"
    output = output + "                value.__self__ is not receiver):\n"
    output = output + "            return None\n"
    output = output + "    elif _lt_bootstrap_builtins.type(descriptor) in (\n"
    output = output + "            getattr(_lt_bootstrap_types, \"MethodDescriptorType\", object),\n"
    output = output + "            getattr(_lt_bootstrap_types, \"WrapperDescriptorType\", object)):\n"
    output = output + "        if (not isinstance(value, _lt_bootstrap_types.BuiltinMethodType) or\n"
    output = output + "                value.__self__ is not receiver):\n"
    output = output + "            return None\n"
    output = output + "    else:\n"
    output = output + "        return None\n"
    output = output + "    cls = _lt_bootstrap_builtins.type(receiver)\n"
    output = output + "    qualified = \"%s.%s\" % (cls.__module__, cls.__qualname__)\n"
    output = output + "    return \"<bound method %s.%s>\" % (qualified, name)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_wgetattr(value, name):\n"
    output = output + "    if isinstance(value, (_LtBootstrapJavaClass, _LtBootstrapJavaHandle)):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"get\", \"target\": jvm.target(value),\n"
    output = output + "                        \"field\": name})\n"
    output = output + "    if isinstance(value, _LtBootstrapModule):\n"
    output = output + "        return _lt_bootstrap_module_function(value, name)\n"
    output = output + "    if isinstance(value, (_LtBootstrapInstance, _LtBootstrapClass)):\n"
    output = output + "        return _lt_bootstrap_base_wgetattr(value, name)\n"
    output = output + "    attribute = getattr(value, name)\n"
    output = output + "    display = _lt_bootstrap_python_bound_method(value, name, attribute)\n"
    output = output + "    if display is not None:\n"
    output = output + "        return _LtBootstrapInteropBoundMethod(\n"
    output = output + "            \"python\", attribute, name, display)\n"
    output = output + "    return _lt_bootstrap_host_result(attribute)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_call(function, *args):\n"
    output = output + "    if isinstance(function, _LtBootstrapFunction):\n"
    output = output + "        return function(*args)\n"
    output = output + "    if isinstance(function, (_LtBootstrapInteropBoundMethod,\n"
    output = output + "                             _LtBootstrapInteropModuleFunction,\n"
    output = output + "                             _LtBootstrapInteropStaticMethod)):\n"
    output = output + "        return _lt_bootstrap_host_result(function(*args))\n"
    output = output + "    if getattr(function, \"__globals__\", None) is globals():\n"
    output = output + "        return function(*args)\n"
    output = output + "    raise TypeError(\"call on non-function value\")\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_wcall(value, name, *args):\n"
    output = output + "    if isinstance(value, (_LtBootstrapJavaClass, _LtBootstrapJavaHandle)):\n"
    output = output + "        _lt_bootstrap_reject_interop_args(args)\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        encoded = [_lt_bootstrap_java_encode(arg) for arg in args]\n"
    output = output + "        if isinstance(value, _LtBootstrapJavaClass) and name == \"new\":\n"
    output = output + "            return jvm.req({\"op\": \"new\", \"class\": value._name,\n"
    output = output + "                            \"args\": encoded})\n"
    output = output + "        return jvm.req({\"op\": \"call\", \"target\": jvm.target(value),\n"
    output = output + "                        \"method\": name, \"args\": encoded})\n"
    output = output + "    if isinstance(value, (_LtBootstrapClass, _LtBootstrapInstance)):\n"
    output = output + "        return _lt_bootstrap_base_wcall(value, name, *args)\n"
    output = output + "    _lt_bootstrap_reject_interop_args(args)\n"
    output = output + "    return _lt_bootstrap_host_result(getattr(value, name)(\n"
    output = output + "        *[_lt_bootstrap_pyarg(argument) for argument in args]))\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_wsetattr(value, name, item):\n"
    output = output + "    if isinstance(value, (_LtBootstrapJavaClass, _LtBootstrapJavaHandle)):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"set\", \"target\": jvm.target(value),\n"
    output = output + "                        \"field\": name, \"value\": _lt_bootstrap_java_encode(item)})\n"
    output = output + "    return _lt_bootstrap_base_wsetattr(value, name, item)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_index(value, key):\n"
    output = output + "    if isinstance(value, _LtBootstrapJavaHandle):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"getitem\", \"target\": jvm.target(value),\n"
    output = output + "                        \"key\": _lt_bootstrap_java_encode(key)})\n"
    output = output + "    return _lt_bootstrap_base_index(value, key)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_wsetindex(value, key, item):\n"
    output = output + "    if isinstance(value, _LtBootstrapJavaHandle):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"setitem\", \"target\": jvm.target(value),\n"
    output = output + "                        \"key\": _lt_bootstrap_java_encode(key),\n"
    output = output + "                        \"value\": _lt_bootstrap_java_encode(item)})\n"
    output = output + "    return _lt_bootstrap_base_wsetindex(value, key, item)\n"
    output = output + "\n"
    output = output + "\n"
    output = output + "def _lt_bootstrap_iter(value):\n"
    output = output + "    if isinstance(value, _LtBootstrapJavaHandle):\n"
    output = output + "        jvm = _lt_bootstrap_jvm_inst()\n"
    output = output + "        return jvm.req({\"op\": \"tolist\", \"target\": jvm.target(value)})\n"
    output = output + "    if isinstance(value, list):\n"
    output = output + "        return value\n"
    output = output + "    if isinstance(value, str):\n"
    output = output + "        return list(value)\n"
    output = output + "    if isinstance(value, dict):\n"
    output = output + "        return list(value.keys())\n"
    output = output + "    raise TypeError(\"cannot iterate \" + _lt_bootstrap_repr(value))\n"
    return output
