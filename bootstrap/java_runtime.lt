# Python interop runtime emitted into generated Python targets.
fn python_string_literal(value):
    escaped = value.replace("\\", "\\\\")
    escaped = escaped.replace("\"", "\\\"")
    escaped = escaped.replace("\n", "\\n")
    return "\"" + escaped + "\""

fn java_runtime_patcher():
    output = "def _lt_bootstrap_patch_java_source(cp, name, old, new, count=1):\n"
    output = output + "    path = _lt_bootstrap_os.path.join(cp, name)\n"
    output = output + "    with open(path, 'r', encoding='utf-8') as stream:\n"
    output = output + "        source = stream.read()\n"
    output = output + "    if source.count(new) >= count:\n        return\n"
    output = output + "    if source.count(old) != count:\n"
    output = output + "        raise RuntimeError('unsupported bundled Java runtime source: ' + name)\n"
    output = output + "    source = source.replace(old, new, count)\n"
    output = output + "    with open(path, 'w', encoding='utf-8', newline='\\n') as stream:\n"
    output = output + "        stream.write(source)\n\n"
    output = output + "def _lt_bootstrap_patch_java_runtime(cp):\n"
    old_encode = "            if (v instanceof Double) {"
    new_encode = "            if (v instanceof Long) return v.toString();\n" + old_encode
    output = output + "    _lt_bootstrap_patch_java_source(cp, 'LtRt.java', " + python_string_literal(old_encode) + ", " + python_string_literal(new_encode) + ")\n"
    old_number = "            Double number() {\n                int j = i;\n                while (j < s.length() && \"-+0123456789.eE\".indexOf(s.charAt(j)) >= 0) j++;\n                double d = Double.parseDouble(s.substring(i, j));\n                i = j;\n                return d;\n            }"
    new_number = "            Object number() {\n                int j = i;\n                while (j < s.length() && \"-+0123456789.eE\".indexOf(s.charAt(j)) >= 0) j++;\n                String raw = s.substring(i, j);\n                i = j;\n                if (raw.indexOf('.') < 0 && raw.indexOf('e') < 0 && raw.indexOf('E') < 0) {\n                    try { return Long.parseLong(raw); }\n                    catch (NumberFormatException e) {\n                        throw new IllegalArgumentException(\"JSON integer outside signed 64-bit range\");\n                    }\n                }\n                return Double.parseDouble(raw);\n            }"
    output = output + "    _lt_bootstrap_patch_java_source(cp, 'LtRt.java', " + python_string_literal(old_number) + ", " + python_string_literal(new_number) + ")\n"
    long_conversion = "        if (value instanceof Long) {\n            long n = (Long) value;\n            if (target == long.class || target == Long.class)\n                return new Conversion(value, 0);\n            if (target == int.class || target == Integer.class) {\n                if (n < Integer.MIN_VALUE || n > Integer.MAX_VALUE) return null;\n                return new Conversion((int) n, 1);\n            }\n            if (target == short.class || target == Short.class) {\n                if (n < Short.MIN_VALUE || n > Short.MAX_VALUE) return null;\n                return new Conversion((short) n, 1);\n            }\n            if (target == byte.class || target == Byte.class) {\n                if (n < Byte.MIN_VALUE || n > Byte.MAX_VALUE) return null;\n                return new Conversion((byte) n, 1);\n            }\n            if (target == double.class || target == Double.class) {\n                double d = (double) n;\n                if (new java.math.BigDecimal(d).compareTo(\n                        java.math.BigDecimal.valueOf(n)) != 0) return null;\n                return new Conversion(d, 1);\n            }\n            if (target == float.class || target == Float.class) {\n                float f = (float) n;\n                if (new java.math.BigDecimal((double) f).compareTo(\n                        java.math.BigDecimal.valueOf(n)) != 0) return null;\n                return new Conversion(f, 1);\n            }\n            if (!target.isPrimitive() && target.isInstance(value))\n                return new Conversion(value, target == Long.class ? 0 : 1);\n            return null;\n        }\n"
    old_convert = "        if (value instanceof Double) {"
    new_convert = long_conversion + old_convert
    output = output + "    _lt_bootstrap_patch_java_source(cp, 'JReflect.java', " + python_string_literal(old_convert) + ", " + python_string_literal(new_convert) + ")\n"
    old_wrap = "        if (v instanceof Number) return ((Number) v).doubleValue();"
    new_wrap = "        if (v instanceof Byte || v instanceof Short ||\n                v instanceof Integer || v instanceof Long)\n            return ((Number) v).longValue();\n        if (v instanceof Float) return ((Float) v).doubleValue();\n        if (v instanceof Number) return new JObj(v);"
    output = output + "    _lt_bootstrap_patch_java_source(cp, 'JReflect.java', " + python_string_literal(old_wrap) + ", " + python_string_literal(new_wrap) + ", 2)\n"
    old_index = "        double d = ((Number) k).doubleValue();"
    new_index = "        if (k instanceof Long) {\n            long value = (Long) k;\n            if (value < -(long) n || value >= (long) n)\n                throw new RuntimeException(\"index out of range: \" + value);\n            return value < 0 ? (int) (value + n) : (int) value;\n        }\n" + old_index
    output = output + "    _lt_bootstrap_patch_java_source(cp, 'LtJavaDaemon.java', " + python_string_literal(old_index) + ", " + python_string_literal(new_index) + ")\n\n"
    return output

fn emitted_prelude():
    output = ""
