    output = output + "        if _lt_bootstrap_os.path.abspath(cp) == _lt_bootstrap_os.path.dirname(_lt_bootstrap_os.path.abspath(__file__)):\n"
    output = output + "            _lt_bootstrap_patch_java_runtime(cp)\n"
