    output = output + "            class_mtime = _lt_bootstrap_os.path.getmtime(class_file)\n"
    output = output + "            if all(_lt_bootstrap_os.path.getmtime(source) <= class_mtime\n"
    output = output + "                   for source in sources):\n"
