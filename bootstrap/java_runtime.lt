    output = output + "            return {\"__num\": \"nan\"}\n"
    output = output + "        if _lt_bootstrap_math.isinf(value):\n"
    output = output + "            return {\"__num\": \"inf\" if value > 0 else \"-inf\"}\n"
    output = output + "        return value\n"
