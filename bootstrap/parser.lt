# P15 M4 structural recursive-descent parser. The parser and AST are Latent;
# Python is used only by the test harness to compile/run this fixture.
import "lexer.lt" as lexer
import "ast.lt" as ast

fn current(p):
    return p["tokens"][p["pos"]]

fn advance(p):
    token = current(p)
    if token["kind"] != "EOF":
        p["pos"] = p["pos"] + 1
    return token

fn fail(p, message):
    return fail_at(p, message, current(p))

fn fail_at(p, message, token):
    p["error"] = message
    p["line"] = token["line"]
    p["col"] = token["col"]
    throw "parser failure"

fn expect(p, kind):
    token = current(p)
    if token["kind"] != kind:
        fail(p, "expected " + kind + ", got " + token["kind"])
    return advance(p)

fn match(p, kind):
    if current(p)["kind"] == kind:
        return advance(p)
    return nil

fn skip_newlines(p):
    while current(p)["kind"] == "NEWLINE":
        advance(p)

fn node(kind, token):
    return ast.make(kind, token["line"], token["col"])

fn parse_block(p):
    expect(p, "NEWLINE")
    expect(p, "INDENT")
    statements = []
    skip_newlines(p)
    while current(p)["kind"] != "DEDENT" and current(p)["kind"] != "EOF":
        statements = statements + [parse_statement(p)]
        skip_newlines(p)
    expect(p, "DEDENT")
    if len(statements) == 0:
        fail(p, "empty block")
    return statements

fn parse_if(p):
    token = expect(p, "IF")
    condition = parse_expression(p)
    expect(p, ":")
    then_body = parse_block(p)
    else_body = nil
    elif_parts = []
    while current(p)["kind"] == "ELIF":
        elif_token = advance(p)
        elif_condition = parse_expression(p)
        expect(p, ":")
        elif_body = parse_block(p)
        elif_parts = elif_parts + [{"token": elif_token, "cond": elif_condition, "body": elif_body}]
    if current(p)["kind"] == "ELSE":
        advance(p)
        expect(p, ":")
        else_body = parse_block(p)
    index = len(elif_parts) - 1
    while index >= 0:
        part = elif_parts[index]
        nested = node("If", part["token"])
        nested["cond"] = part["cond"]
        nested["then_body"] = part["body"]
        nested["else_body"] = else_body
        else_body = [nested]
        index = index - 1
    result = node("If", token)
    result["cond"] = condition
    result["then_body"] = then_body
    result["else_body"] = else_body
    return result

fn parameter_node(kind, token, name):
    result = node(kind, token)
    result["name"] = name
    return result

fn parse_formal_parameters(p):
    params = []
    specs = []
    saw_default = false
    saw_star = false
    saw_extra = false
    bare_star = false
    bare_star_token = nil
    keyword_only_count = 0
    if current(p)["kind"] != ")":
        while true:
            token = current(p)
            if token["kind"] == "**":
                marker = advance(p)
                if saw_extra:
                    fail_at(p, "multiple **extra parameters", marker)
                name = expect(p, "NAME")
                entry = parameter_node("ExtraParam", marker, name["value"])
                params = params + [entry]
                specs = specs + [entry]
                saw_extra = true
            elif token["kind"] == "*":
                marker = advance(p)
                if saw_star or saw_extra:
                    fail_at(p, "*rest must precede **extra and appear once", marker)
                saw_star = true
                if current(p)["kind"] == "NAME":
                    name = advance(p)
                    entry = parameter_node("RestParam", marker, name["value"])
                    params = params + [entry]
                    specs = specs + [entry]
                else:
                    bare_star = true
                    bare_star_token = marker
            else:
                if saw_extra:
                    fail_at(p, "positional parameter follows variadic parameter", token)
                name = expect(p, "NAME")
                if match(p, "=") != nil:
                    default = parse_expression(p)
                    if saw_star:
                        entry = parameter_node("KeywordOnlyParam", name, name["value"])
                        entry["default"] = default
                        params = params + [entry]
                        specs = specs + [entry]
                        keyword_only_count = keyword_only_count + 1
                    else:
                        saw_default = true
                        entry = parameter_node("DefaultParam", name, name["value"])
                        entry["default"] = default
                        params = params + [entry]
                        specs = specs + [entry]
                else:
                    if saw_star:
                        entry = parameter_node("KeywordOnlyParam", name, name["value"])
                        entry["default"] = nil
                        params = params + [entry]
                        specs = specs + [entry]
                        keyword_only_count = keyword_only_count + 1
                    elif saw_default:
                        fail_at(p, "required parameter follows defaulted parameter", name)
                    else:
                        params = params + [name["value"]]
                        specs = specs + [parameter_node("PositionalParam", name, name["value"])]
            if match(p, ",") == nil:
                break
    if bare_star and keyword_only_count == 0:
        fail_at(p, "bare * must be followed by at least one keyword-only parameter", bare_star_token)
    expect(p, ")")
    return {"params": params, "specs": specs}

fn parse_function(p):
    token = expect(p, "FN")
    name = expect(p, "NAME")
    expect(p, "(")
    formal = parse_formal_parameters(p)
    result = node("FnDef", token)
    result["name"] = name["value"]
    result["source_name"] = name["value"]
    result["params"] = formal["params"]
    result["param_specs"] = formal["specs"]
    if match(p, "=>") != nil:
        value = parse_expression(p)
        expect(p, "NEWLINE")
        returned = node("Return", token)
        returned["value"] = value
        result["body"] = [returned]
    else:
        expect(p, ":")
        result["body"] = parse_block(p)
    return result

fn parse_import(p):
    token = expect(p, "IMPORT")
    module = expect(p, "STR")
    expect(p, "AS")
    alias = expect(p, "NAME")
    expect(p, "NEWLINE")
    result = node("ImportStmt", token)
    result["module_path"] = module["value"]
    result["alias"] = alias["value"]
    return result

fn parse_binding_declaration(p, token, kind):
    names = [expect(p, "NAME")["value"]]
    while match(p, ",") != nil:
        names = names + [expect(p, "NAME")["value"]]
    expect(p, "NEWLINE")
    result = node(kind, token)
    result["names"] = names
    return result

fn parse_class(p):
    token = expect(p, "CLASS")
    name = expect(p, "NAME")
    parent = nil
    if match(p, "(") != nil:
        parent_name = expect(p, "NAME")
        alias = nil
        if match(p, ".") != nil:
            alias = parent_name["value"]
            parent_name = expect(p, "NAME")
        parent = node("ClassRef", parent_name)
        parent["name"] = parent_name["value"]
        parent["alias"] = alias
        if alias == nil:
            parent["display"] = parent_name["value"]
        else:
            parent["display"] = alias + "." + parent_name["value"]
        expect(p, ")")
    expect(p, ":")
    expect(p, "NEWLINE")
    expect(p, "INDENT")
    methods = []
    skip_newlines(p)
    while current(p)["kind"] != "DEDENT":
        if current(p)["kind"] != "FN":
            fail(p, "only fn definitions allowed in class body")
        methods = methods + [parse_function(p)]
        skip_newlines(p)
    expect(p, "DEDENT")
    if len(methods) == 0:
        fail_at(p, "class '" + name["value"] + "' has no methods", token)
    result = node("ClassDef", token)
    result["name"] = name["value"]
    result["source_name"] = name["value"]
    result["methods"] = methods
    result["parent"] = parent
    return result

fn parse_try(p):
    token = expect(p, "TRY")
    expect(p, ":")
    body = parse_block(p)
    expect(p, "CATCH")
    variable = expect(p, "NAME")
    expect(p, ":")
    handler = parse_block(p)
    result = node("Try", token)
    result["body"] = body
    result["var"] = variable["value"]
    result["handler"] = handler
    return result

fn parse_statement(p):
    token = current(p)
    if token["kind"] == "IMPORT":
        return parse_import(p)
    if token["kind"] == "GLOBAL":
        advance(p)
        return parse_binding_declaration(p, token, "GlobalStmt")
    if token["kind"] == "NONLOCAL":
        advance(p)
        return parse_binding_declaration(p, token, "NonlocalStmt")
    if token["kind"] == "FN":
        return parse_function(p)
    if token["kind"] == "CLASS":
        return parse_class(p)
    if token["kind"] == "TRY":
        return parse_try(p)
    if token["kind"] == "IF":
        return parse_if(p)
    if token["kind"] == "WHILE":
        advance(p)
        condition = parse_expression(p)
        expect(p, ":")
        result = node("While", token)
        result["cond"] = condition
        result["body"] = parse_block(p)
        return result
    if token["kind"] == "FOR":
        advance(p)
        variable = expect(p, "NAME")
        expect(p, "IN")
        iterable = parse_expression(p)
        expect(p, ":")
        result = node("For", token)
        result["var"] = variable["value"]
        result["iter"] = iterable
        result["body"] = parse_block(p)
        return result
    if token["kind"] == "SAY":
        advance(p)
        result = node("Say", token)
        result["value"] = parse_expression(p)
        expect(p, "NEWLINE")
        return result
    if token["kind"] == "RETURN":
        advance(p)
        result = node("Return", token)
        if current(p)["kind"] == "NEWLINE":
            result["value"] = nil
        else:
            result["value"] = parse_expression(p)
        expect(p, "NEWLINE")
        return result
    if token["kind"] == "THROW":
        advance(p)
        result = node("Throw", token)
        result["value"] = parse_expression(p)
        expect(p, "NEWLINE")
        return result
    if token["kind"] == "BREAK" or token["kind"] == "CONTINUE":
        advance(p)
        if token["kind"] == "BREAK":
            result = node("Break", token)
        else:
            result = node("Continue", token)
        expect(p, "NEWLINE")
        return result
    expression = parse_expression(p)
    if current(p)["kind"] == "=":
        assignment = advance(p)
        value = parse_expression(p)
        expect(p, "NEWLINE")
        kind = expression["type"]
        if kind != "Name" and kind != "Dot" and kind != "Subscript":
            p["error"] = "cannot assign to this expression"
            p["line"] = expression["line"]
            p["col"] = expression["col"]
            throw "parser failure"
        result = node("Assign", token)
        result["target"] = expression
        result["value"] = value
        return result
    expect(p, "NEWLINE")
    result = node("ExprStmt", token)
    result["expr"] = expression
    return result

fn parse_expression(p):
    return parse_or(p)

fn parse_or(p):
    left = parse_and(p)
    while current(p)["kind"] == "OR":
        operator = advance(p)
        right = parse_and(p)
        result = node("BinOp", operator)
        result["op"] = "or"
        result["left"] = left
        result["right"] = right
        left = result
    return left

fn parse_and(p):
    left = parse_not(p)
    while current(p)["kind"] == "AND":
        operator = advance(p)
        right = parse_not(p)
        result = node("BinOp", operator)
        result["op"] = "and"
        result["left"] = left
        result["right"] = right
        left = result
    return left

fn parse_not(p):
    if current(p)["kind"] == "NOT":
        operator = advance(p)
        result = node("UnOp", operator)
        result["op"] = "not"
        result["operand"] = parse_not(p)
        return result
    return parse_comparison(p)

fn parse_comparison(p):
    left = parse_additive(p)
    kind = current(p)["kind"]
    if kind == "==" or kind == "!=" or kind == "<" or kind == "<=" or kind == ">" or kind == ">=":
        operator = advance(p)
        right = parse_additive(p)
        result = node("BinOp", operator)
        result["op"] = operator["kind"]
        result["left"] = left
        result["right"] = right
        return result
    return left

fn parse_additive(p):
    left = parse_multiplicative(p)
    while current(p)["kind"] == "+" or current(p)["kind"] == "-":
        operator = advance(p)
        right = parse_multiplicative(p)
        result = node("BinOp", operator)
        result["op"] = operator["kind"]
        result["left"] = left
        result["right"] = right
        left = result
    return left

fn parse_multiplicative(p):
    left = parse_factor(p)
    while current(p)["kind"] == "*" or current(p)["kind"] == "/" or current(p)["kind"] == "%":
        operator = advance(p)
        right = parse_factor(p)
        result = node("BinOp", operator)
        result["op"] = operator["kind"]
        result["left"] = left
        result["right"] = right
        left = result
    return left

fn parse_factor(p):
    if current(p)["kind"] == "-":
        operator = advance(p)
        result = node("UnOp", operator)
        result["op"] = operator["kind"]
        result["operand"] = parse_factor(p)
        return result
    return parse_power(p)

fn parse_power(p):
    left = parse_postfix(p)
    if current(p)["kind"] == "**":
        operator = advance(p)
        right = parse_factor(p)
        result = node("BinOp", operator)
        result["op"] = "**"
        result["left"] = left
        result["right"] = right
        return result
    return left

fn parse_call_arguments(p):
    args = []
    saw_keyword = false
    if current(p)["kind"] == ")":
        return args
    while true:
        token = current(p)
        if token["kind"] == "**":
            marker = advance(p)
            argument = node("StarStarArg", marker)
            argument["value"] = parse_expression(p)
            args = args + [argument]
            saw_keyword = true
        elif token["kind"] == "*":
            marker = advance(p)
            if saw_keyword:
                fail_at(p, "positional unpacking follows named argument", marker)
            argument = node("StarArg", marker)
            argument["value"] = parse_expression(p)
            args = args + [argument]
        elif token["kind"] == "NAME" and p["tokens"][p["pos"] + 1]["kind"] == "=":
            name = advance(p)
            advance(p)
            argument = node("NamedArg", name)
            argument["name"] = name["value"]
            argument["value"] = parse_expression(p)
            args = args + [argument]
            saw_keyword = true
        else:
            if saw_keyword:
                fail_at(p, "positional argument follows named argument", token)
            args = args + [parse_expression(p)]
        if match(p, ",") == nil:
            break
    return args

fn parse_postfix(p):
    expression = parse_primary(p)
    while true:
        if current(p)["kind"] == "(":
            token = advance(p)
            args = parse_call_arguments(p)
            expect(p, ")")
            result = node("Call", token)
            result["func"] = expression
            result["args"] = args
            expression = result
        elif current(p)["kind"] == ".":
            advance(p)
            attr = expect(p, "NAME")
            result = node("Dot", attr)
            result["obj"] = expression
            result["attr"] = attr["value"]
            expression = result
        elif current(p)["kind"] == "[":
            token = advance(p)
            index = parse_expression(p)
            expect(p, "]")
            result = node("Subscript", token)
            result["obj"] = expression
            result["index"] = index
            expression = result
        else:
            break
    return expression

fn parse_primary(p):
    token = current(p)
    kind = token["kind"]
    if kind == "NUM":
        advance(p)
        result = node("Num", token)
        result["value"] = token["value"]
        return result
    if kind == "STR":
        advance(p)
        result = node("Str", token)
        result["value"] = token["value"]
        return result
    if kind == "TRUE" or kind == "FALSE":
        advance(p)
        result = node("Bool", token)
        result["value"] = kind == "TRUE"
        return result
    if kind == "NIL":
        advance(p)
        return node("Nil", token)
    if kind == "NAME":
        advance(p)
        result = node("Name", token)
        result["id"] = token["value"]
        return result
    if kind == "SUPER":
        advance(p)
        return node("Super", token)
    if kind == "PY":
        advance(p)
        result = node("PyImport", token)
        result["module_expr"] = parse_primary(p)
        return result
    if kind == "JAVA":
        advance(p)
        result = node("JavaImport", token)
        result["class_expr"] = parse_primary(p)
        return result
    if kind == "(":
        advance(p)
        expression = parse_expression(p)
        expect(p, ")")
        return expression
    if kind == "[":
        advance(p)
        elements = []
        if current(p)["kind"] != "]":
            elements = [parse_expression(p)]
            while match(p, ",") != nil:
                if current(p)["kind"] == "]":
                    break
                elements = elements + [parse_expression(p)]
        expect(p, "]")
        result = node("List", token)
        result["elts"] = elements
        return result
    if kind == "{":
        advance(p)
        pairs = []
        if current(p)["kind"] != "}":
            pairs = [parse_map_pair(p)]
            while match(p, ",") != nil:
                if current(p)["kind"] == "}":
                    break
                pairs = pairs + [parse_map_pair(p)]
        expect(p, "}")
        result = node("Map", token)
        result["pairs"] = pairs
        return result
    fail(p, "unexpected " + kind + " in expression")

fn parse_map_pair(p):
    token = current(p)
    if token["kind"] != "STR" and token["kind"] != "NAME":
        fail(p, "map keys must be strings or bare names")
    advance(p)
    key = token["value"]
    expect(p, ":")
    pair = {"key": key, "value": parse_expression(p)}
    return pair

fn tag_source_nodes(nodes, source_id):
    if nodes == nil:
        return
    for child in nodes:
        tag_source_node(child, source_id)

fn tag_source_node(value, source_id):
    if value == nil:
        return
    value["source_id"] = source_id
    kind = value["type"]
    if kind == "Program":
        tag_source_nodes(value["stmts"], source_id)
    elif kind == "FnDef":
        tag_source_nodes(value["param_specs"], source_id)
        tag_source_nodes(value["body"], source_id)
    elif kind == "ClassDef":
        tag_source_node(value["parent"], source_id)
        tag_source_nodes(value["methods"], source_id)
    elif kind == "If":
        tag_source_node(value["cond"], source_id)
        tag_source_nodes(value["then_body"], source_id)
        tag_source_nodes(value["else_body"], source_id)
    elif kind == "While":
        tag_source_node(value["cond"], source_id)
        tag_source_nodes(value["body"], source_id)
    elif kind == "For":
        tag_source_node(value["iter"], source_id)
        tag_source_nodes(value["body"], source_id)
    elif kind == "Try":
        tag_source_nodes(value["body"], source_id)
        tag_source_nodes(value["handler"], source_id)
    elif kind == "Say" or kind == "Return" or kind == "Throw":
        tag_source_node(value["value"], source_id)
    elif kind == "ExprStmt":
        tag_source_node(value["expr"], source_id)
    elif kind == "Assign":
        tag_source_node(value["target"], source_id)
        tag_source_node(value["value"], source_id)
    elif kind == "BinOp":
        tag_source_node(value["left"], source_id)
        tag_source_node(value["right"], source_id)
    elif kind == "UnOp":
        tag_source_node(value["operand"], source_id)
    elif kind == "List":
        tag_source_nodes(value["elts"], source_id)
    elif kind == "Map":
        for pair in value["pairs"]:
            tag_source_node(pair["value"], source_id)
    elif kind == "Call":
        tag_source_node(value["func"], source_id)
        tag_source_nodes(value["args"], source_id)
    elif kind == "Dot":
        tag_source_node(value["obj"], source_id)
    elif kind == "Subscript":
        tag_source_node(value["obj"], source_id)
        tag_source_node(value["index"], source_id)
    elif kind == "PyImport":
        tag_source_node(value["module_expr"], source_id)
    elif kind == "JavaImport":
        tag_source_node(value["class_expr"], source_id)
    elif kind == "DefaultParam" or kind == "KeywordOnlyParam":
        tag_source_node(value["default"], source_id)
    elif kind == "NamedArg" or kind == "StarArg" or kind == "StarStarArg":
        tag_source_node(value["value"], source_id)

fn parse_tokens(tokens, source_id=nil):
    parser = {"tokens": tokens, "pos": 0, "error": "", "line": 0, "col": 0}
    try:
        statements = []
        skip_newlines(parser)
        while current(parser)["kind"] != "EOF":
            statements = statements + [parse_statement(parser)]
            skip_newlines(parser)
        tree = ast.program(statements)
        tag_source_node(tree, source_id)
        return {"ok": true, "tree": tree, "error": nil, "line": 0, "col": 0}
    catch ignored:
        return {"ok": false, "tree": nil, "error": parser["error"], "line": parser["line"], "col": parser["col"]}

fn parse(source, source_id=nil):
    tokenized = lexer.lex(source)
    if not tokenized["ok"]:
        return {"ok": false, "tree": nil, "error": tokenized["error"], "line": tokenized["line"], "col": tokenized["col"]}
    return parse_tokens(tokenized["tokens"], source_id)
